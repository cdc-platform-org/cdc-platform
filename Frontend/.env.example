# Copy this file to .env.local and fill in real values before running the app.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything
# else here is read server-side only (in pages/api/* routes).

# Base URL of the backend API. Defaults to http://localhost:4000/api if unset
# (see src/services/apiClient.ts) — set to the real deployed backend origin
# (e.g. https://api.example.com/api) in production.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Google Cloud OAuth 2.0 Web application Client ID — enables the "Sign in
# with Google" button in AuthModal.tsx / GoogleSignInButton.tsx. Must be the
# SAME Google Cloud OAuth client as Backend/.env's GOOGLE_CLIENT_ID. Leave
# blank to leave the Google button disabled/hidden.
#
# This uses Google Identity Services (GIS) — a client-side ID-token flow,
# NOT a server-side OAuth redirect. There is no "redirect URI" / "callback
# URL" to configure. Setup in Google Cloud Console:
#   1. console.cloud.google.com → APIs & Services → Credentials
#   2. Create (or reuse) an "OAuth 2.0 Client ID" of type "Web application"
#   3. Under "Authorized JavaScript origins", add every origin that will
#      load this site's GSI script (pages/_app.tsx), e.g.:
#        https://cdc.org.ge
#        https://www.cdc.org.ge   (if used)
#        http://localhost:3000    (for local dev)
#      NOTE: this is "Authorized JavaScript origins", NOT "Authorized
#      redirect URIs" — GIS doesn't use a redirect URI at all. The single
#      most common cause of "Unable to sign in with Google" in production
#      is the live domain missing from this list, or this env var simply
#      not being set in the hosting provider's (e.g. Vercel) project env
#      vars — check both if Google sign-in fails only in production.
#   4. Copy the generated Client ID here AND into Backend/.env's
#      GOOGLE_CLIENT_ID — they must be byte-identical, since the backend
#      verifies the ID token's audience against its own copy.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Gemini API key for the homepage AI Career Assistant chatbot
# (pages/api/chat.ts / lib/gemini.ts, server-side only — deliberately NOT
# NEXT_PUBLIC_). Leave blank and the chat endpoint responds with a friendly
# "not configured" message; the rest of the site is unaffected. Same key as
# Backend/.env's GEMINI_API_KEY.
GEMINI_API_KEY=

# Shared secret that authenticates Vercel's own Cron trigger for
# pages/api/cron/generate-blog.ts (Mon & Thu, see vercel.json) — Vercel
# automatically sends `Authorization: Bearer $CRON_SECRET` on scheduled cron
# requests when this is set as a Vercel project env var. Must be the SAME
# value as Backend/.env's CRON_SECRET — this route forwards it as Backend's
# expected X-Cron-Secret header. Leave blank to disable the cron route
# (responds 501) without affecting anything else on the site.
CRON_SECRET=

# NOTE: Bunny Stream credentials (BUNNY_STREAM_API_KEY,
# BUNNY_STREAM_LIBRARY_ID, BUNNY_CDN_HOSTNAME) are NOT used anywhere in this
# Frontend project — lesson video upload/playback is entirely backend-driven
# (see Backend/.env.example). Don't set them here.

# Sentry error tracking (instrumentation.ts / instrumentation-client.ts).
# NEXT_PUBLIC_ because a DSN isn't a secret — it's write-only, scoped to
# accepting events for this project. Leave blank and Sentry stays fully
# disabled (no SDK calls, no network activity) — same "optional until set"
# pattern as every other integration above.
NEXT_PUBLIC_SENTRY_DSN=

# Only needed to upload source maps on build (readable stack traces in
# Sentry) — requires an org's own Sentry account. Leave all three blank and
# the build just skips that step silently.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
