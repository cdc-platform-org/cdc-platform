datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  Student
  Mentor
  SuperAdmin
  // Renamed from EnterpriseClient — same role (gig/vacancy posting client),
  // just a shorter name now that registration exposes it as a self-serve
  // choice ("💼 დამკვეთი") rather than an admin-only/B2B-only designation.
  Client
}

// Which of the two onboarding paths the student picked at registration
// (`register.tsx`'s Step 1) — purely descriptive/analytics; it does not
// replace `Role` (still Student/Client) since "Freelancer" and "Business"
// aren't distinct roles in this schema, just labels for what a Student or
// verified Client account can already do.
enum PrimaryIntent {
  TALENT
  EMPLOYER
}

// Richer verification state than a plain `isVerified` boolean alone can
// express (specifically: a distinct PENDING state between "never
// submitted" and "approved", plus a REJECTED terminal state) — see
// User.verificationStatus. Originally BUSINESS-only (named
// BusinessVerificationStatus); the level a given submission is FOR is now
// tracked separately by User.verificationLevel, so this enum's values are
// level-agnostic (UNVERIFIED/PENDING/APPROVED/REJECTED, not "unsubmitted
// business"/"verified business"). `isVerified` stays as the single source
// every existing BUSINESS-tools access-check (business tools gate, AI
// Agents Suite, admin dashboards) already reads — it is deliberately NOT
// repurposed to mean "verified at any level," since flipping it true for
// an INDIVIDUAL verification would incorrectly unlock business-only gates.
// `isVerified`/`verificationStatus` are still always written together at
// the one place BUSINESS verification changes (routes/adminCompanies.ts's
// setVerified()) rather than one being computed from the other, since
// Prisma has no computed-field support.
enum VerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

// Which kind of verification a user has submitted/holds — NONE (default)
// means no submission has ever been made. Deliberately a separate field
// from `verificationStatus` above rather than folding level into the
// status enum (e.g. "BUSINESS_PENDING"), since the two vary independently:
// a resubmission after rejection keeps the same level but resets status,
// and every status transition (routes/adminCompanies.ts for BUSINESS,
// the individual-verification review path for INDIVIDUAL) only ever
// touches whichever level's own downstream unlock this triggers — an
// INDIVIDUAL approval sets isVerifiedGraduate-adjacent freelancer rights
// (see the routes that read this alongside isVerifiedGraduate), a
// BUSINESS approval sets `isVerified` — never both from one submission.
enum VerificationLevel {
  NONE
  INDIVIDUAL
  BUSINESS
}

enum UserStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum GigBudgetType {
  fixed
  hourly
}

// Two distinct postings share the Gig table because they're the same
// underlying shape (title/description/budget/category) with different
// directionality: CLIENT_REQUEST is a client asking for a freelancer
// ("looking for a designer"); FREELANCER_OFFER is a freelancer advertising
// their own service ("I design logos, hire me"). offerType picks which set
// of fields (deadline vs portfolioLinks+deliveryDays) postGigSchema requires
// — see Backend/src/schemas/gigSchemas.ts.
enum GigOfferType {
  CLIENT_REQUEST
  FREELANCER_OFFER
}

// Professional job/project category — optional (nullable) so existing
// gigs/vacancies posted before this field existed don't need backfilling.
// Shown as a filter/badge on the marketplace; `other` is the deliberate
// escape hatch for anything that doesn't fit the four named categories.
enum JobCategory {
  ui_ux_design
  web_development
  graphic_design
  digital_marketing
  other
}

enum GigStatus {
  open
  assigned
  submitted
  completed
  cancelled
}

enum ApplicationStatus {
  submitted
  reviewed
  accepted
  rejected
}

enum EscrowStatus {
  HELD_IN_ESCROW
  RELEASED
  REFUNDED
  DISPUTED
}

enum WalletEntryType {
  ESCROW_RELEASE_CREDIT
  PRODUCT_SALE_CREDIT
  MENTORSHIP_SESSION_CREDIT
  HR_SUPPORT_CREDIT
  PAYOUT_DEBIT
  // Restores the PAYOUT_DEBIT when a PROCESSING PayoutRequest ends in
  // FAILED (BOG rejected the transfer, or its confirmation webhook never
  // arrived within the timeout) — see bogPayoutService.markFailed. Kept
  // distinct from ADJUSTMENT (an admin's manual balance correction) so a
  // wallet history reader can tell "the system reversed its own debit"
  // from "an admin changed this by hand" at a glance.
  PAYOUT_REVERSAL
  ADJUSTMENT
}

enum EmploymentType {
  full_time
  part_time
  contract
  internship
}

enum VacancyStatus {
  open
  closed
  filled
  // Not yet published to the public listing (GET /vacancies filters to
  // moderationStatus 'approved' only, but a draft is additionally excluded
  // by status so a half-finished posting never leaks even if moderation
  // logic changes later) — lets an employer save a job posting before
  // it's ready to accept applications.
  draft
}

enum OrderStatus {
  Pending
  Approved
  Processing
  Completed
  Cancelled
}

enum ReviewType {
  CLIENT_TO_FREELANCER
  FREELANCER_TO_CLIENT
}

enum DirectOfferStatus {
  pending
  accepted
  declined
  withdrawn
}

// Internal admin-team permission tier — deliberately separate from `Role`
// (the marketplace role: Student/Mentor/SuperAdmin/EnterpriseClient). A user
// can have a marketplace role AND, independently, a seat on the admin team.
// SCREAMING_SNAKE_CASE on purpose, to keep it visually distinct from `Role`
// at every call site and avoid the two ever being confused for each other.
enum AdminRole {
  SUPER_ADMIN
  // Renamed from ADMIN — same tier (course CMS, gigs moderation, disputes),
  // just a name that matches the platform's public RBAC hierarchy naming.
  MANAGER
  MODERATOR
}

enum ListingModerationStatus {
  approved
  removed
}

// Digital Store usage rights — DigitalProduct.licenseType is the terms a
// buyer agrees to at checkout; ProductPurchase.licenseType is a snapshot of
// that value taken at fulfillment time (see productSaleService.ts), so a
// later admin edit to the catalog listing's license never retroactively
// changes what an existing buyer already purchased.
enum ProductLicenseType {
  PERSONAL_USE
  COMMERCIAL_USE
  EXTENDED_COMMERCIAL
}

// Background 3-language (ka/en/ru) subtitle generation for a lesson video
// (see services/subtitleService.ts) — null means no video has ever
// triggered the pipeline yet.
enum SubtitlesStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum BogPaymentPurpose {
  COURSE
  MENTORSHIP
  GIG_ESCROW_FUNDING
  PRODUCT
  HR_SUPPORT
}

// Mirrors BOG's own order_status.key values (see GET /payments/v1/receipt/:id)
// down to PENDING/COMPLETED/FAILED/CANCELLED — collapsed to our 4 states
// rather than mirroring their full state machine (created/processing/
// refund_requested/refunded/etc), since refunds aren't implemented here.
enum BogPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  // Set only by an admin's manual "Refund & Access Revocation" action
  // (see routes/adminFinance.ts) — this is a record-keeping status, it does
  // NOT itself trigger a real bank refund through BOG; the admin still
  // processes the actual refund via BOG's own dashboard/support.
  REFUNDED
}

// ============================================================
// USER
// ============================================================

model User {
  id                            String              @id @default(uuid())
  email                         String              @unique
  password                      String
  name                          String
  role                          Role                @default(Student)
  // Captures `role` at the moment POST /admin/mentorship/mentors/promote
  // overwrites it with `Mentor` — the only way to know which of Student/
  // Client to revert to on POST /admin/mentorship/mentors/:userId/demote,
  // since `role` itself is a single field with no history. Null for every
  // non-Mentor account, and for any Mentor promoted before this field
  // existed (demote falls back to Student for those).
  preMentorRole                 Role?
  status                        UserStatus          @default(PENDING_APPROVAL)
  rejectionReason               String?
  earningsBalance               Int                 @default(0)
  // Denormalized rollup of `reviewsReceived`, recomputed on every new review —
  // avoids an AVG() aggregate query every time a rating needs to be displayed
  // (profile pages, gig/vacancy cards, etc).
  averageRating                 Float?
  reviewCount                   Int                 @default(0)
  // Same denormalized-rollup pattern as averageRating/reviewCount above, but
  // for this user's Digital Store listings as a seller/creator (ProductReview,
  // recomputed on every product review create/delete) — deliberately a
  // separate figure from the gig-marketplace rating above, since a great
  // freelancer and a great product creator are different reputations. Null/0
  // for users who have never had a product reviewed (including anyone who
  // has never submitted a product at all).
  sellerRating                  Float?
  sellerReviewCount             Int                 @default(0)
  // Set only by a SuperAdmin (POST /api/admin/users/:id/verify-graduate) once
  // they've confirmed the user actually completed a CDC course — there is no
  // automated course-completion pipeline yet, so this is a manual gate.
  isVerifiedGraduate            Boolean             @default(false)
  // Grants access to /admin/hr-requests's specialist-facing screens
  // (assigned requests, candidate scoring matrix) — deliberately NOT part
  // of AdminRoleTier/requireAdminRole: an HR specialist is very likely an
  // external contractor and should only ever see the specific requests
  // assigned to them, never the general admin panel a SUPER_ADMIN/MANAGER/
  // MODERATOR gets. Set manually by a SuperAdmin for now (no self-serve
  // application flow yet).
  isHrSpecialist                Boolean             @default(false)
  // Set when a freelancer skill exam attempt is force-submitted for
  // repeated anti-cheat violations (tab switch/fullscreen exit, see
  // routes/freelancerExam.ts) — blocks starting a new attempt until this
  // timestamp passes. null means not locked.
  examLockedUntil               DateTime?
  // Freelancer's self-declared skills — a mix of values from the curated
  // list in src/data/freelancerSkills.ts and free-typed "Other" entries;
  // both are stored the same way, as plain strings. This is a separate,
  // per-skill system from isVerifiedGraduate above: a skill here only shows
  // a "Verified" badge (see VerifiedSkill) once the freelancer passes an
  // AI-generated test for it, or a completed course auto-verifies it.
  freelancerSkills              String[]            @default([])
  // Soft-delete: set the moment the user confirms account deletion. The
  // account is deactivated immediately (blocked from logging in or taking
  // marketplace actions). 60 days later, the cleanup cron either hard-deletes
  // the row (if nothing references it) or anonymizes it in place (see
  // dataPurgedAt) when other users' financial/activity records depend on it.
  deletionRequestedAt           DateTime?
  // Set when the 60-day cleanup cron anonymizes (rather than hard-deletes)
  // this row, so the cron doesn't keep re-processing it on every run.
  dataPurgedAt                  DateTime?
  // Self-service email verification (separate from `status`'s admin-approval
  // gate — both must clear before protected actions, see requireApproved).
  // Set immediately for Google sign-ups (Google already verified the email).
  // Existing rows are backfilled to their createdAt at migration time so this
  // new gate doesn't retroactively lock out accounts that predate it.
  emailVerifiedAt               DateTime?
  emailVerificationToken        String?             @unique
  emailVerificationTokenExpires DateTime?
  // Self-service password reset (POST /api/auth/forgot-password + /reset-password).
  passwordResetToken            String?             @unique
  passwordResetTokenExpires     DateTime?
  // Set for accounts created (or later linked) via Google/GitHub/Facebook
  // Sign-In. Such accounts get a random unusable password hash — there is
  // no password-based login path for them unless they later set one (see
  // routes/auth.ts).
  googleId                      String?             @unique
  githubId                      String?             @unique
  facebookId                    String?             @unique
  // Internal admin-team tier (see AdminRole) — null means "not on the admin
  // team." Independent of `role`; set only via the admin Team Management
  // panel (SUPER_ADMIN-only) or the one-off seed utility.
  adminRole                     AdminRole?
  // Admin-initiated ban (distinct from `deletionRequestedAt`, which is
  // self-service account deletion). A banned user is blocked from logging in
  // and from every requireApproved-gated action, same enforcement points as
  // deletion, but reversible and admin-controlled.
  isBanned                      Boolean             @default(false)
  bannedAt                      DateTime?
  banReason                     String?
  // Legal identity fields — self-reported by the student under
  // /dashboard/settings. Deliberately separate from the display `name`
  // (which can be anything): certificates and payout paperwork use these
  // when set, since they need to match the person's actual ID/bank records.
  // All optional — falls back to `name` for both languages until filled in.
  legalFirstNameKa              String?
  legalLastNameKa               String?
  legalFirstNameEn              String?
  legalLastNameEn               String?
  nationalId                    String?
  // 11-digit Georgian personal ID number — anti-fraud KYC constraint on the
  // "ფიზიკური პირი" (Individual) verification tab, enforcing one verified
  // account per real identity. Deliberately a separate field from
  // nationalId above (that one's a free-form invoicing field with no
  // uniqueness guarantee and pre-dates this constraint); @unique allows
  // any number of NULLs (users who haven't submitted individual
  // verification yet) but rejects a second account claiming the same
  // number — see routes/auth.ts's /me/individual-verification-doc.
  personalNumber                String?             @unique
  phone                         String?
  // Default IBAN pre-filled into new payout requests — the request itself
  // still stores its own snapshot, so changing this later doesn't alter
  // past requests.
  payoutIban                    String?
  // Stamped by PUT /auth/me whenever payoutIban actually changes (null on
  // an account that has never set one). The one input the bogPayoutService
  // risk engine cannot derive from PayoutRequest alone — a session/account
  // takeover that silently redirects payouts by editing this field, then
  // immediately requests a payout, must never sail through auto-approval
  // just because the amount is small and the account is old. See
  // subscriptionStateService.ts-style "single source of truth" reasoning:
  // this is the one place that decision is made, not re-derived ad hoc at
  // review time.
  payoutIbanUpdatedAt           DateTime?
  // Profile picture — set only via POST /api/auth/me/avatar (uploads
  // straight to Bunny Storage, see services/bunnyStorage.ts), never a
  // freely-settable URL, so a user's public-facing avatar can't be pointed
  // at an arbitrary external image.
  avatarUrl                     String?
  // Short bio/headline shown on the profile — self-reported, plain text.
  // Georgian primary; bioEn is optional and falls back to bio when unset,
  // same twin-field convention as BlogPost.title/titleEn etc.
  bio                           String?
  bioEn                         String?
  // Public mentor-directory fields — only meaningful for role Mentor (same
  // not-schema-restricted posture as the business fields below), edited by
  // an admin on /admin/mentorship. mentorHourlyRate is minor units (tetri),
  // same convention as Course.originalPrice. mentorTitleEn follows the same
  // optional-twin-falls-back-to-Georgian convention as bioEn above.
  mentorTitle                   String?
  mentorTitleEn                 String?
  mentorHourlyRate              Int?
  // Gates visibility on the public /mentors directory (routes/mentorship.ts's
  // GET /mentors) — deliberately separate from `status` (which governs
  // whether the account can log in / act at all, same as every other role).
  // Being promoted to Mentor (adminMentorship.ts's SUPER_ADMIN-only
  // /mentors/promote) does NOT set this true — an admin must explicitly
  // publish the profile via PUT /mentors/:mentorId/profile. No mentor-facing
  // route ever writes this field; only the admin one does, same posture as
  // course pricing/catalog content.
  mentorPublished               Boolean             @default(false)
  mentorSkills                  String[]            @default([])
  // Spoken languages, e.g. ["ქართული", "English"] — free-text tags picked
  // from a curated checklist in the admin UI, not a DB enum (same posture
  // as mentorSkills).
  mentorLanguages               String[]            @default([])
  // CV/résumé (PDF/DOCX), uploaded via POST /admin/mentorship/mentors/:id/cv
  // — a public CDN URL like the other Bunny-Storage-backed uploads in this
  // codebase; there's nothing sensitive in a mentor's own public CV.
  cvUrl                         String?
  // Which onboarding path this account picked at registration (Step 1 of
  // register.tsx) — Student/Client role is unchanged by this, see
  // PrimaryIntent's own comment. Null for every account created before
  // this field existed.
  primaryIntent                 PrimaryIntent?
  // Self-uploaded verification document — either a Public Registry Extract
  // / company registration doc (BUSINESS level, reviewed by
  // routes/adminCompanies.ts) or a personal ID card/passport scan
  // (INDIVIDUAL level) — which one it is is `verificationLevel` below, not
  // a separate URL field, since a user only ever has one active submission
  // at a time. `isVerified` remains the single field every existing
  // BUSINESS-only access-check reads; `verificationStatus` adds the
  // PENDING/REJECTED distinction a plain boolean can't express, kept in
  // sync with it at the one place both ever change for BUSINESS
  // submissions. Uploading a new doc after rejection resets status back to
  // PENDING so a resubmission always lands back in the review queue.
  verificationDocUrl            String?
  verificationLevel             VerificationLevel   @default(NONE)
  isVerified                    Boolean             @default(false)
  verificationStatus            VerificationStatus? @default(UNVERIFIED)
  // Self-reported identification code (ს/კ) — compared against whatever
  // ID the AI parser extracts from the uploaded document (see
  // services/businessKycService.ts) to auto-verify on an exact match.
  // Must be filled in by the business before auto-verification can ever
  // fire; blank always falls through to manual admin review.
  taxId                         String?
  // Structured output of the last Gemini KYC parse (see
  // services/businessKycService.ts) — companyName/registrationDate/
  // registryAuthority/activeStatus/directors bundled as one JSON blob since
  // they're only ever read together (the admin inspection drawer's
  // extracted-vs-entered comparison) and never individually queried/
  // filtered on. Same naming convention as Product.aiReviewScore/
  // aiReviewConfidence/aiReviewReasoning/aiReviewedAt. Null until the first
  // document upload; overwritten (not appended) on every resubmission.
  businessKycExtractedData      Json?
  businessKycScore              Int?
  businessKycReasoning          String?
  businessKycCheckedAt          DateTime?
  // Set only by an admin's POST /admin/companies/:id/reject — distinct from
  // the account-approval UserStatus.rejectionReason above, which is a
  // different flow entirely.
  businessKycRejectionReason    String?
  // Business/employer profile fields — only meaningful for role Client, but
  // not schema-restricted to it (same posture as the legal-identity fields
  // above, which are equally open to every role). `avatarUrl` doubles as
  // the company logo for Client accounts rather than a separate field —
  // it's already just "this account's picture," and a second logo-specific
  // upload endpoint would be pure duplication. Contact person name/email/
  // phone reuse the existing `name`/email/`phone` fields for the same
  // reason — a Client account IS the contact person's login.
  companyName                   String?
  industry                      String?
  websiteUrl                    String?
  companyDescription            String?
  // Terms & Conditions consent — set explicitly (POST /api/auth/accept-terms)
  // the moment a user agrees, never implied. New email/password registrations
  // set this immediately (the checkbox is required to submit that form); new
  // Google sign-ups do NOT set it at account-creation time, since there's no
  // separate consent step before the account is created there — the frontend
  // shows a blocking first-login modal for any authenticated user where this
  // is still null (covers both that case and every account that predates
  // this field, which is why existing rows are deliberately NOT backfilled
  // to createdAt the way emailVerifiedAt was).
  termsAcceptedAt               DateTime?
  // AI Agents Suite (Frontend's /dashboard/ai-tools "content generator /
  // market analytics / business assistant" tools) — a 7-day trial set the
  // moment a Business account is FIRST verified (routes/adminCompanies.ts's
  // setVerified), never reset by a later re-verify. Distinct from the
  // pre-existing Agent.trialEndsAt, which is the 60-day trial for a
  // business's own embeddable customer-facing chatbot — a separate product.
  // See utils/aiAgentsSuiteAccess.ts for how these two fields combine with
  // role === SuperAdmin to decide access.
  // When the trial above actually started — aiTrialEndsAt alone only ever
  // recorded the end date, not the start, which existing code never needed
  // (isTrialActive is deliberately NOT a stored column — trivially derived
  // as aiTrialEndsAt > now(), and a boolean copy of that would be exactly
  // the kind of two-fields-can-drift redundancy avoided everywhere else in
  // this model).
  trialStartDate                DateTime?
  aiTrialEndsAt                 DateTime?
  aiSubscriptionActive          Boolean             @default(false)
  createdAt                     DateTime            @default(now())

  postedGigs                    Gig[]                         @relation("PostedGigs")
  assignedGigs                  Gig[]                         @relation("AssignedGigs")
  gigApplications               GigApplication[]
  clientTransactions            GigTransaction[]              @relation("ClientTransactions")
  freelancerTransactions        GigTransaction[]              @relation("FreelancerTransactions")
  walletEntries                 WalletEntry[]
  postedVacancies               Vacancy[]
  vacancyApplications           VacancyApplication[]
  blogPosts                     BlogPost[]
  reviewsGiven                  Review[]                      @relation("ReviewsGiven")
  reviewsReceived               Review[]                      @relation("ReviewsReceived")
  sentDirectOffers              DirectOffer[]                 @relation("SentDirectOffers")
  receivedDirectOffers          DirectOffer[]                 @relation("ReceivedDirectOffers")
  sentMessages                  Message[]                     @relation("SentMessages")
  receivedMessages              Message[]                     @relation("ReceivedMessages")
  // One Stripe Customer per platform user, created lazily the first time
  // they start adding a card (see stripePaymentService.getOrCreateStripeCustomerId)
  // — every saved PaymentMethod of provider STRIPE is attached to this same
  // customer, which is what makes "reuse this card for a future charge"
  // possible at all on Stripe's side. Null until that first card add.
  stripeCustomerId              String?
  paymentMethods                PaymentMethod[]
  bogPayments                   BogPayment[]
  stripePayments                StripePayment[]
  courseEnrollments             CourseEnrollment[]
  lessonProgress                LessonProgress[]
  courseCertificates            CourseCertificate[]
  courseDiscussionPosts         CourseDiscussionPost[]
  examAttempts                  ExamAttempt[]
  freelancerSkillExamAttempts   FreelancerSkillExamAttempt[]
  skillTestAttempts             SkillTestAttempt[]
  verifiedSkills                VerifiedSkill[]
  productPurchases              ProductPurchase[]
  assignmentSubmissions         AssignmentSubmission[]
  submittedProducts             DigitalProduct[]              @relation("SubmittedProducts")
  productReviewsGiven           ProductReview[]               @relation("ProductReviewsGiven")
  productReviewHelpfulVotes     ProductReviewHelpfulVote[]
  forumThreads                  ForumThread[]
  forumComments                 ForumComment[]
  forumThreadLikes              ForumThreadLike[]
  forumCommentLikes             ForumCommentLike[]
  disputesRaised                Dispute[]                     @relation("DisputesRaised")
  disputesResolved              Dispute[]                     @relation("DisputesResolved")
  payoutRequests                PayoutRequest[]               @relation("PayoutRequests")
  payoutRequestsReviewed        PayoutRequest[]               @relation("PayoutRequestsReviewed")
  auditLogs                     AuditLog[]
  siteContentUpdates            SiteContent[]
  studioInquiriesReviewed       StudioInquiry[]
  // CDC Business AI — a Business (Client) account's chat agents. See the
  // Agent model's own comment for why billing fields live there instead of
  // a separate Subscription model for now.
  agents                        Agent[]
  examSessions                  ExamSession[]
  billingSubscriptions          BillingSubscription[]
  blogComments                  BlogComment[]
  mentorshipRequestsMade        MentorshipRequest[]           @relation("MentorshipRequestsMade")
  mentorshipRequestsResolved    MentorshipRequest[]           @relation("MentorshipRequestsResolved")
  notifications                 Notification[]
  mentorAvailabilityRules       MentorAvailabilityRule[]
  mentorAvailabilityExceptions  MentorAvailabilityException[]
  sentNotificationBatches       NotificationBatch[]
  mentorshipBookingsAsMentor    MentorshipBooking[]           @relation("MentorshipBookingsAsMentor")
  mentorshipBookingsAsStudent   MentorshipBooking[]           @relation("MentorshipBookingsAsStudent")
  mentorBookingHistoryActions   MentorBookingHistory[]        @relation("MentorBookingHistoryActor")
  mentorChatMessagesSent        MentorChatMessage[]           @relation("MentorChatMessagesSent")
  mentorChatMessagesReceived    MentorChatMessage[]           @relation("MentorChatMessagesReceived")
  mentorChatViolations          MentorChatViolation[]         @relation("MentorChatViolations")
  cyberSentinelDevices          CyberSentinelDevice[]         @relation("CyberSentinelDevices")
  reviewedGrantOpportunities    GrantOpportunity[]
  generatedLaunchKits           LaunchKit[]
  chatRequestsSent              ChatRequest[]                 @relation("ChatRequestsSent")
  chatRequestsReceived          ChatRequest[]                 @relation("ChatRequestsReceived")
  chatFlagsAsSender             ChatFlag[]                    @relation("ChatFlagsAsSender")
  chatFlagsAsRecipient          ChatFlag[]                    @relation("ChatFlagsAsRecipient")
  chatFlagsReviewed             ChatFlag[]                    @relation("ChatFlagsReviewed")
  hrSupportRequestsAsClient     HRSupportRequest[]            @relation("HRSupportRequestsAsClient")
  hrSupportRequestsAsSpecialist HRSupportRequest[]            @relation("HRSupportRequestsAsSpecialist")

  @@map("users")
}

// ============================================================
// GIG
// ============================================================

model Gig {
  id                    String                  @id @default(uuid())
  title                 String
  description           String
  postedById            String
  postedBy              User                    @relation("PostedGigs", fields: [postedById], references: [id], onDelete: Restrict)
  budgetType            GigBudgetType
  budgetAmount          Int
  currency              String                  @db.Char(3)
  skillsRequired        String[]
  category              JobCategory?
  // Free-typed category when category is 'other' — the JobCategory enum
  // itself has no room for arbitrary text, so this is what actually gets
  // displayed in place of the generic "Other" label wherever this listing's
  // category is shown (see utils/jobCategory.ts's jobCategoryLabel).
  customCategory        String?
  deadline              DateTime?
  // See GigOfferType. FREELANCER_OFFER postings use portfolioLinks +
  // deliveryDays instead of deadline.
  offerType             GigOfferType            @default(CLIENT_REQUEST)
  portfolioLinks        String[]                @default([])
  deliveryDays          Int?
  status                GigStatus               @default(open)
  assignedFreelancerId  String?
  assignedFreelancer    User?                   @relation("AssignedGigs", fields: [assignedFreelancerId], references: [id], onDelete: SetNull)
  // Denormalized count of `applications`, incremented alongside each new
  // GigApplication — lets job cards show "N proposals" without a join/count
  // query on every listing fetch.
  applicationsCount     Int                     @default(0)
  // Set when the freelancer submits delivered work (status -> submitted).
  // The 7-day auto-approve cron reads submittedAt to find overdue reviews.
  submittedAt           DateTime?
  deliveryComment       String?
  deliveryFiles         String[]                @default([])
  // Set when the assigned freelancer clicks "Request CDC Mentor Help" —
  // surfaces in the admin mentorship queue. Whether this is the student's
  // first-ever gig is computed at read time (their completed-gig count),
  // not stored, so it can never drift out of sync.
  mentorHelpRequestedAt DateTime?
  deliveryLinks         String[]                @default([])
  // Post-hoc moderation (not a pre-publish queue — listings go live
  // immediately on posting, same as before; a moderator can take one down
  // after the fact). Defaults to approved so existing behavior is unchanged.
  moderationStatus      ListingModerationStatus @default(approved)
  moderatedAt           DateTime?
  moderationReason      String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  applications GigApplication[]
  transaction  GigTransaction?
  reviews      Review[]
  directOffers DirectOffer[]
  disputes     Dispute[]

  @@index([status])
  @@index([status, skillsRequired])
  @@index([moderationStatus])
  @@map("gigs")
}

// ============================================================
// GIG APPLICATION
// ============================================================

model GigApplication {
  id           String            @id @default(uuid())
  gigId        String
  gig          Gig               @relation(fields: [gigId], references: [id], onDelete: Cascade)
  applicantId  String
  applicant    User              @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  proposalNote String
  bidAmount    Int
  deliveryDays Int               @default(7)
  status       ApplicationStatus @default(submitted)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  transaction GigTransaction?

  @@unique([gigId, applicantId])
  @@index([status])
  @@map("gig_applications")
}

// ============================================================
// GIG TRANSACTION (Escrow ledger — capture record)
// ============================================================

model GigTransaction {
  id               String         @id @default(uuid())
  gigId            String         @unique
  gig              Gig            @relation(fields: [gigId], references: [id], onDelete: Restrict)
  gigApplicationId String         @unique
  gigApplication   GigApplication @relation(fields: [gigApplicationId], references: [id], onDelete: Restrict)
  clientId         String
  client           User           @relation("ClientTransactions", fields: [clientId], references: [id], onDelete: Restrict)
  freelancerId     String
  freelancer       User           @relation("FreelancerTransactions", fields: [freelancerId], references: [id], onDelete: Restrict)
  grossAmount      Int
  commissionRate   Float
  commissionAmount Int
  netAmount        Int
  currency         String         @db.Char(3)
  status           EscrowStatus   @default(HELD_IN_ESCROW)
  providerRef      String         @unique
  capturedAt       DateTime
  releasedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  walletEntries WalletEntry[]

  @@index([status])
  @@map("gig_transactions")
}

// ============================================================
// WALLET ENTRY (Escrow ledger — append-only, immutable)
// ============================================================

model WalletEntry {
  id                         String             @id @default(uuid())
  userId                     String
  user                       User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  type                       WalletEntryType
  amount                     Int
  relatedGigTransactionId    String?
  relatedGigTransaction      GigTransaction?    @relation(fields: [relatedGigTransactionId], references: [id], onDelete: SetNull)
  relatedMentorshipBookingId String?
  relatedMentorshipBooking   MentorshipBooking? @relation(fields: [relatedMentorshipBookingId], references: [id], onDelete: SetNull)
  relatedHRSupportRequestId  String?
  relatedHRSupportRequest    HRSupportRequest?  @relation(fields: [relatedHRSupportRequestId], references: [id], onDelete: SetNull)
  balanceAfter               Int
  createdAt                  DateTime           @default(now())

  @@index([userId])
  @@map("wallet_entries")
}

// ============================================================
// VACANCY
// ============================================================

model Vacancy {
  id                  String                  @id @default(uuid())
  title               String
  description         String
  postedById          String
  postedBy            User                    @relation(fields: [postedById], references: [id], onDelete: Restrict)
  employmentType      EmploymentType
  location            String
  skillsRequired      String[]
  category            JobCategory?
  // See the identical field's comment on Gig.
  customCategory      String?
  salaryMin           Int?
  salaryMax           Int?
  currency            String?                 @db.Char(3)
  applicationDeadline DateTime?
  status              VacancyStatus           @default(open)
  moderationStatus    ListingModerationStatus @default(approved)
  moderatedAt         DateTime?
  moderationReason    String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  applications      VacancyApplication[]
  hrSupportRequests HRSupportRequest[]

  @@index([status])
  @@index([moderationStatus])
  @@map("vacancies")
}

// ============================================================
// VACANCY APPLICATION
// ============================================================

model VacancyApplication {
  id          String            @id @default(uuid())
  vacancyId   String
  vacancy     Vacancy           @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User              @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  coverNote   String
  status      ApplicationStatus @default(submitted)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Set only when this application is swept into a paid HR Assistance
  // request (see HRSupportRequest) — most applications never have one.
  hrEvaluation CandidateEvaluation?

  @@unique([vacancyId, applicantId])
  @@index([status])
  @@map("vacancy_applications")
}

// ============================================================
// HR ASSISTANCE — a paid, human-delivered candidate-screening service an
// employer can request on top of a Vacancy they've posted. Escrow lifecycle
// mirrors MentorshipBooking's held-escrow model (mentorshipEscrowService.ts)
// almost exactly, just inlined here the same way rather than a separate
// transaction table: capture happens on payment (see routes/payments.ts's
// HR_SUPPORT branch), release happens on the employer's explicit
// confirmation OR an N-day auto-release sweep once the specialist marks the
// request DELIVERED, OR an admin resolving a raised dispute. See
// services/hrSupportEscrowService.ts.
// ============================================================

model HRSupportRequest {
  id                   String    @id @default(uuid())
  vacancyId            String
  vacancy              Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  requestedById        String
  requestedBy          User      @relation("HRSupportRequestsAsClient", fields: [requestedById], references: [id], onDelete: Restrict)
  assignedSpecialistId String?
  assignedSpecialist   User?     @relation("HRSupportRequestsAsSpecialist", fields: [assignedSpecialistId], references: [id], onDelete: SetNull)
  // Snapshot of the vacancy's applicant count at request time — this is what
  // grossAmount was actually priced against (200 GEL base for the first 10,
  // +50 GEL per candidate beyond that), kept even if applications change
  // later so the price never silently drifts from what was charged.
  candidateCount       Int
  grossAmount          Int
  currency             String    @default("GEL") @db.Char(3)
  // Timestamp of the employer's mandatory ToS/effort-based-disclaimer
  // checkbox at request time — never null, required before checkout can
  // even start (see hrSupportSchemas.ts).
  tosAcceptedAt        DateTime
  // "PENDING_PAYMENT" | "AWAITING_ASSIGNMENT" | "IN_PROGRESS" | "DELIVERED" | "CANCELLED"
  // — plain string, same convention as MentorshipBooking.status, kept
  // separate from the escrow fields below (escrowStatus tracks the money,
  // this tracks the actual screening work).
  status               String    @default("PENDING_PAYMENT")
  // Locked in at capture time — see the commissionRate comment on
  // MentorshipBooking, same reasoning (must not retroactively move if the
  // platform's split changes later).
  commissionRate       Float?
  commissionAmount     Int?
  netAmount            Int?
  escrowStatus         String?
  paidAt               DateTime?
  assignedAt           DateTime?
  // Set by the assigned specialist once the Top-3 report is ready — starts
  // the auto-release clock (see HR_AUTO_RELEASE_GRACE_MS in
  // hrSupportEscrowService.ts).
  deliveredAt          DateTime?
  reportSummary        String?
  autoReleaseAt        DateTime?
  releasedAt           DateTime?
  // "CLIENT_CONFIRMED" | "AUTO_RELEASE" | "ADMIN_RESOLVED"
  releaseTrigger       String?
  disputeRaisedAt      DateTime?
  disputeReason        String?
  disputeResolvedAt    DateTime?
  // "RELEASE" | "REFUND"
  disputeResolution    String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  candidateEvaluations CandidateEvaluation[]
  walletEntries        WalletEntry[]

  @@index([status])
  @@index([requestedById])
  @@index([assignedSpecialistId])
  @@map("hr_support_requests")
}

// One row per applicant swept into a paid HRSupportRequest — created
// up-front for every VacancyApplication on the vacancy at request time (see
// the comment on candidateCount above), then filled in by the assigned
// specialist as screening progresses.
model CandidateEvaluation {
  id               String             @id @default(uuid())
  hrRequestId      String
  hrRequest        HRSupportRequest   @relation(fields: [hrRequestId], references: [id], onDelete: Cascade)
  applicationId    String             @unique
  application      VacancyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // 0-100 each — kept as separate dimensions (rather than one composite
  // score) so the employer-facing comparison matrix is transparent about
  // *why* a candidate ranked where they did, not a black-box number.
  hardSkillsScore  Int?
  softSkillsScore  Int?
  taskScore        Int?
  culturalFitScore Int?
  overallRank      Int?
  hrNotes          String?
  // External meeting link (Google Meet/Zoom) — no in-platform video for
  // this MVP, see the architecture report this feature was speced from.
  meetingUrl       String?
  interviewAt      DateTime?
  // "PENDING" | "TASK_SENT" | "TASK_SUBMITTED" | "INTERVIEWED" | "SCORED"
  status           String             @default("PENDING")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([hrRequestId])
  @@map("hr_candidate_evaluations")
}

// Anti-fraud KYC cap on the "ბიზნესი" (Business) verification tab — up to
// maxAccounts distinct User accounts may verify with the same taxId (see
// routes/auth.ts's /me/verification-doc) before submissions are blocked
// with "ეს ს/კ უკვე გამოყენებულია...". No row = the platform default of 3
// (BUSINESS_TAX_ID_DEFAULT_LIMIT in routes/auth.ts) applies; a SuperAdmin
// creates one via routes/adminCompanies.ts to raise or remove (maxAccounts
// null) the limit for a specific legitimate multi-branch business.
model BusinessAccountLimit {
  id          String   @id @default(uuid())
  taxId       String   @unique
  // null = unlimited (explicit admin override to remove the cap entirely,
  // not "unset" — a genuinely unset taxId never gets a row at all).
  maxAccounts Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("business_account_limits")
}

// ============================================================
// COURSE
// ============================================================

enum CourseLanguage {
  GEORGIAN
  ENGLISH
  BOTH
}

model Course {
  id              String         @id @default(uuid())
  title           String
  // Optional English translation of `title` — never guessed/auto-translated.
  // When set, the certificate PDF prints "title / titleEn"; course pages
  // otherwise always display the plain `title` (single-language courses are
  // the common case, so nothing else reads this field).
  titleEn         String?
  description     String
  // Optional English translation of `description`, same never-guessed/
  // never-auto-translated posture as titleEn. The course detail page shows
  // this instead of `description` when the site's active language is EN,
  // falling back to `description` when unset — see pages/courses/[id]/index.tsx.
  descriptionEn   String?
  category        String
  // Admin-set (see admin/courses.tsx) list of freelancer skills (curated
  // src/data/freelancerSkills.ts values, or free text) this course teaches.
  // When a student earns this course's certificate, every skill listed here
  // is auto-verified on their profile (VerifiedSkillSource.COURSE_COMPLETION)
  // without needing the AI skill test — see routes/courses.ts. Independent
  // of `category` above (a plain, unrelated free-text field).
  skillsTaught    String[]       @default([])
  // Legacy flat lesson blob — predates CourseSection/Lesson below and is left
  // as-is for backward compat with the existing admin course-create form
  // (lib/api.ts's CoursePayload). The Udemy-style /learn player reads the
  // relational `sections` instead.
  lessons         Json
  // Minor units (tetri) — matches this codebase's Int-money convention
  // everywhere else (Gig.budgetAmount, BogPayment.amount, etc.). The user-
  // facing "sale price" is never stored — see services/coursePricing.ts's
  // getCurrentPrice(), computed at read time so an expired discountEndDate
  // reverts to originalPrice automatically with no cron/cleanup needed.
  originalPrice   Int
  discountPercent Int?
  discountEndDate DateTime?
  isOnSale        Boolean        @default(false)
  published       Boolean        @default(false)
  mentorName      String?
  mentorTitle     String?
  thumbnailUrl    String?
  // Full-width hero banner on the course landing page — distinct from
  // thumbnailUrl (card/list thumbnail). Optional; falls back to no hero
  // image when unset.
  coverImageUrl   String?
  // Rendered as a vertical portrait next to mentorName/mentorTitle on the
  // landing page — falls back to initials when unset.
  mentorAvatarUrl String?
  // Instruction language, shown as a badge on course cards. Defaults to
  // GEORGIAN since every pre-existing course is Georgian-taught.
  language        CourseLanguage @default(GEORGIAN)
  // Null (the default/common case) = unlimited seats, same "absence means
  // no limit" posture as PromoCode.maxUses. Set for capacity-capped cohorts
  // (e.g. a live masterclass) — checked at checkout-initiation time in
  // payments.ts/stripePayments.ts against a live CourseEnrollment count
  // (never a stored counter, so it can't drift out of sync with reality).
  maxCapacity     Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  orders             Order[]                @relation("OrderCourses")
  enrollments        CourseEnrollment[]
  sections           CourseSection[]
  certificates       CourseCertificate[]
  // One AI-generated certification exam per course, if configured by an
  // admin — courses without one keep the old "100% lessons" certificate gate
  // (see routes/courses.ts's GET /:id/certificate).
  exam               Exam?
  discussionPosts    CourseDiscussionPost[]
  // Set once a LiveTraining recording gets turned into this course — see
  // LiveTraining.convertedToCourseId's own comment for why this is a link
  // rather than a merge.
  liveTrainingSource LiveTraining?
  launchKits         LaunchKit[]

  @@map("courses")
}

// ============================================================
// LIVE TRAININGS — one-off scheduled workshops sold as a lead-capture form
// (name/email/phone), not a purchase: registering doesn't grant access to
// anything by itself, it queues a callback for the team to schedule the
// session by phone. Deliberately its own model rather than a Course
// `type` field — a live training has no lessons/sections/exam/certificate,
// and forcing it through Course's shape would leave most of that model
// meaningless for every row of this kind (same reasoning MentorshipBooking
// is its own model instead of an Order variant).
// ============================================================

model LiveTraining {
  id                  String   @id @default(uuid())
  title               String
  titleEn             String?
  description         String
  descriptionEn       String?
  category            String
  scheduledAt         DateTime
  // Minor units (tetri), same Int-money convention as Course.originalPrice
  // elsewhere. Nullable — a lead-gen/intro session may be free, with any
  // real payment collected on the follow-up call rather than through this
  // registration form.
  price               Int?
  thumbnailUrl        String?
  // Promo/demo clip — either a pasted YouTube/Vimeo link or a direct
  // .mp4/.webm/.ogg URL, same convention and rendering (VideoEmbed.tsx) as
  // StudioCaseStudy.videoUrl. No upload path — always a plain URL.
  videoUrl            String?
  // Group-viability floor — see LiveTrainingLead's registeredCount-derived
  // "min threshold met" badge on both the admin and public pages. 0 means
  // no minimum is enforced.
  minCapacity         Int      @default(0)
  maxCapacity         Int
  published           Boolean  @default(false)
  // Set once an admin turns the recording into a real Course. A link, not a
  // merge: the new Course still needs real sections/lessons authored by
  // hand, this just lets past leads be notified and traced back to the
  // session that originated the course.
  convertedToCourseId String?  @unique
  convertedToCourse   Course?  @relation(fields: [convertedToCourseId], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  leads LiveTrainingLead[]

  @@index([published])
  @@map("live_trainings")
}

enum LiveTrainingLeadStatus {
  NOT_CONTACTED
  CONTACTED
  SCHEDULED
  DECLINED
}

// A no-login registration — same shape as StudioInquiry (name/email/phone +
// admin-managed status), not a User relation, since a prospective trainee
// registering by phone number has no reason to have an account yet.
model LiveTrainingLead {
  id             String                 @id @default(uuid())
  liveTrainingId String
  liveTraining   LiveTraining           @relation(fields: [liveTrainingId], references: [id], onDelete: Cascade)
  name           String
  email          String
  phone          String
  status         LiveTrainingLeadStatus @default(NOT_CONTACTED)
  adminNote      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([liveTrainingId])
  @@index([status])
  @@map("live_training_leads")
}

// ============================================================
// LMS — relational curriculum (sections -> lessons), per-user lesson
// progress, and issued certificates. Coexists with the legacy Course.lessons
// Json blob above.
// ============================================================

model CourseSection {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  // Optional English translation of `title` — same never-auto-translated-
  // by-default posture as Course.titleEn (this one CAN be filled by the
  // "Auto-Translate to English via Gemini" action, see aiTranslateService's
  // translateCourse, but is never generated implicitly).
  titleEn   String?
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId])
  @@map("course_sections")
}

model Lesson {
  id                 String           @id @default(uuid())
  sectionId          String
  section            CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title              String
  // Optional English translation of `title` — see CourseSection.titleEn's
  // comment.
  titleEn            String?
  durationSeconds    Int              @default(0)
  // Bunny Stream video GUID (services/bunnyStreamService.ts) — null until an
  // admin uploads a video for this lesson.
  bunnyVideoId       String?
  resources          String[]         @default([])
  order              Int
  // Watchable by anyone on the public course landing page without
  // enrolling — see routes/courses.ts's GET /:id/syllabus, which only
  // includes embedUrl for these lessons.
  isFreePreview      Boolean          @default(false)
  // Optional homework prompt shown on the student player's Assignment tab
  // — null means the lesson has no assignment (existing behavior).
  assignmentPrompt   String?
  // Optional English translation of `assignmentPrompt` — same posture as
  // titleEn above. Only meaningful when assignmentPrompt is set.
  assignmentPromptEn String?
  // Auto-generated ka/en/ru captions (services/subtitleService.ts), fired
  // fire-and-forget right after a successful video upload — see
  // POST /lessons/:lessonId/video. null until a video has ever triggered it.
  subtitlesStatus    SubtitlesStatus?
  subtitlesError     String?
  // "Conspectus" — the AI-filtered actionable-takeaways summary (not a
  // verbatim transcript) generated by the same pipeline run, right after
  // the base transcript succeeds. Reuses SubtitlesStatus rather than a
  // duplicate enum, since it's genuinely the same PENDING/PROCESSING/
  // COMPLETED/FAILED lifecycle as the subtitle job's own status. Each
  // language's text is nullable independently — a language that fails its
  // pass just leaves that one field null, same partial-success posture as
  // subtitle uploads.
  conspectusStatus   SubtitlesStatus?
  conspectusError    String?
  conspectusKa       String?
  conspectusEn       String?
  conspectusRu       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  progress    LessonProgress[]
  submissions AssignmentSubmission[]

  @@index([sectionId])
  @@map("lessons")
}

// One row per student per lesson — resubmission overwrites the same row
// (see the unique constraint) rather than piling up duplicates, so a
// "needs revision" -> resubmit cycle stays a single record with fresh status.
model AssignmentSubmission {
  id        String   @id @default(uuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl   String?
  linkUrl   String?
  comment   String?
  // "PENDING" | "APPROVED" | "NEEDS_REVISION"
  status    String   @default("PENDING")
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, userId])
  @@index([userId])
  @@map("assignment_submissions")
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

// One row per (user, course) once a certificate has been generated — makes
// re-downloads idempotent (same verification code every time) rather than
// minting a new "unique" code on every click.
model CourseCertificate {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId          String
  course            Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  verificationCode  String    @unique
  issuedAt          DateTime  @default(now())
  // One-download-per-student-per-course limit (see GET /:id/certificate) —
  // 0 means never downloaded via the student dashboard's authenticated
  // download button; further attempts are turned away with a "contact
  // support" message instead of a fresh PDF. Deliberately does not apply to
  // the public code-based /certificates/download/:code route, which serves
  // a different purpose (sharing/re-verifying an already-issued credential).
  downloadCount     Int       @default(0)
  firstDownloadedAt DateTime?

  @@unique([userId, courseId])
  @@map("course_certificates")
}

// Retroactive/manual certificates — issued by an admin for a graduate/course
// that doesn't (or no longer does) exist as a real User/Course row, so unlike
// CourseCertificate this stores the student/course/instructor as plain text
// rather than FKs. GET /verify/:code checks this table as a fallback after
// CourseCertificate. issuedByAdminId is a plain audit field, not a relation —
// deliberately not touching the User model's relation list for this.
model ManualCertificate {
  id               String    @id @default(uuid())
  verificationCode String    @unique
  studentNameKa    String
  studentNameEn    String?
  studentEmail     String
  courseTitleKa    String
  courseTitleEn    String?
  instructorName   String
  issueDate        DateTime
  issuedByAdminId  String
  emailSentAt      DateTime?
  createdAt        DateTime  @default(now())

  @@map("manual_certificates")
}

// ============================================================
// AI EXAM & CERTIFICATION GATE — one Exam per course (admin-configured);
// questions are generated on demand by services/aiExamService.ts, not
// stored ahead of time. Each attempt is scored server-side and recorded
// here; GET /:id/certificate requires a `passed` ExamAttempt to exist for
// courses that have an Exam configured.
// ============================================================

model Exam {
  id       String @id @default(uuid())
  courseId String @unique
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Percentage (0-100) required to pass, e.g. 95.
  passingScore    Int     @default(95)
  // Minimum wait between a failed attempt and the next one.
  cooldownHours   Int     @default(24)
  questionCount   Int     @default(10)
  // Free-text steer for the AI question generator (topics to emphasize,
  // difficulty, tone) — appended to the base prompt in aiExamService.ts.
  aiPromptContext String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts ExamAttempt[]

  @@map("exams")
}

model ExamAttempt {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  score       Float
  passed      Boolean
  // Snapshot of the questions this attempt was scored against (including
  // correct answers + explanations) — lets a student review what they got
  // wrong without trusting the client to have kept an honest copy.
  questions   Json
  weakTopics  String[] @default([])
  completedAt DateTime @default(now())

  @@index([userId, examId])
  @@index([examId])
  @@map("exam_attempts")
}

// Category-based skill-verification exam for the freelance marketplace —
// distinct from the course-completion ExamAttempt above (no Exam/course
// behind it, just a JobCategory). Passing (score >= 80) sets the same
// isVerifiedGraduate flag/badge used across the marketplace, rather than
// introducing a second parallel "verified" concept.
model FreelancerSkillExamAttempt {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Kept for backward compatibility with rows created before multi-
  // profession selection existed — always set to categories[0] on new
  // attempts. `categories` (plural) is the real source of truth going
  // forward; a test now spans every profession the user selected, not just
  // one, per the Freelancer verification tab in VerificationDrawer.
  category         JobCategory
  categories       JobCategory[] @default([])
  // Free-typed profession when "სხვა" (Other) is selected — blended into
  // the AI prompt alongside `categories`, if any are also selected.
  customProfession String?
  // Snapshot including correct answers/explanations, same reasoning as
  // ExamAttempt.questions — graded server-side against this, never trusts
  // the client's copy.
  questions        Json
  answers          Json?
  score            Float?
  passed           Boolean       @default(false)
  createdAt        DateTime      @default(now())
  completedAt      DateTime?

  @@index([userId])
  @@map("freelancer_skill_exam_attempts")
}

// One row per per-skill AI test attempt (distinct from the older, single-
// category FreelancerSkillExamAttempt above) — 5 multiple-choice questions
// plus 1 open-ended practical question, both AI-generated for the specific
// skillName (src/data/freelancerSkills.ts value, or a free-typed "Other"
// skill — either way just a string, not a JobCategory enum). Passing
// (totalScore >= 80) creates/updates a VerifiedSkill row for this skill
// rather than touching the platform-wide isVerifiedGraduate flag — these
// are separate, additive credentials.
model SkillTestAttempt {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillName      String
  // Full snapshot including correct answers (MCQ) and the grading rubric
  // (practical) — graded server-side against this, never trusts the
  // client's copy, same reasoning as ExamAttempt.questions.
  questions      Json
  answers        Json?
  mcqScore       Float?
  practicalScore Float?
  totalScore     Float?
  passed         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([userId])
  @@map("skill_test_attempts")
}

enum VerifiedSkillSource {
  AI_TEST
  COURSE_COMPLETION
}

// A freelancer's earned "Verified Skill" badge — one row per (userId,
// skillName), created either by passing a SkillTestAttempt (AI_TEST) or by
// completing a course whose Course.skillsTaught includes this skill
// (COURSE_COMPLETION, see routes/courses.ts's certificate-issuance path).
// Rendered as a badge on the public profile (pages/profile/[userId].tsx).
model VerifiedSkill {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillName   String
  verifiedVia VerifiedSkillSource
  // Only set for AI_TEST — the passing SkillTestAttempt's totalScore.
  score       Float?
  // Only set for COURSE_COMPLETION — which course auto-verified this skill.
  // No relation/onDelete behavior tied to Course: if the course is later
  // deleted, the badge the freelancer already earned is still theirs to keep.
  courseId    String?
  verifiedAt  DateTime            @default(now())

  @@unique([userId, skillName])
  @@map("verified_skills")
}

// Digital Store — downloadable products CDC sells directly (UI kits, AI
// prompt packs, templates, e-books), separate from Course/Gig commerce.
// price/ProductPurchase.amount are Int minor units (tetri), matching
// Course.originalPrice/BogPayment.amount elsewhere — not Float, to avoid
// floating-point rounding on money.
model DigitalProduct {
  id                 String             @id @default(uuid())
  title              String
  // Auto-translated by Gemini at create/update time whenever left blank
  // (see aiTranslateService.ts's translateTitleAndDescription, wired into
  // routes/products.ts and routes/adminProducts.ts) — unlike Course/blog/
  // mentor's *En fields, which are deliberately never auto-fired and stay
  // opt-in via a manual "Auto-Translate" button.
  titleEn            String?
  description        String
  descriptionEn      String?
  // Minor units (tetri), matching every other money field in this schema.
  price              Int
  // Absolute sale price, also minor units — NOT a percent, unlike
  // Course.discountPercent. Null (the common case) means no sale. Validated
  // against MIN_SALE_PRICE_MINOR/MAX_DISCOUNT_PERCENT (services/
  // productPricing.ts) at write time, not here — same "validation lives in
  // the Zod schema/route, not the DB" posture as everything else in this
  // file. getCurrentProductPrice()/withCurrentProductPrice() compute the
  // actual charged price at read time, same pattern as Course's
  // originalPrice/discountPercent via coursePricing.ts — deliberately a
  // second, differently-shaped mechanism rather than retrofitting Course's
  // percent-based one, since a seller here sets an absolute floor price,
  // not "X% off," and the two models' commission/ownership semantics
  // already differ (Course has no per-item creator split).
  discountedPrice    Int?
  // Null = sale never expires until discountedPrice is unset. Past this
  // moment, getCurrentProductPrice() reverts to `price` automatically — no
  // cron needed, same as Course.discountEndDate.
  saleEndsAt         DateTime?
  category           String
  imageUrl           String
  // Up to 4 additional showcase screenshots shown alongside imageUrl (the
  // main cover) in the /store/[id] gallery/carousel — same array-of-URLs
  // pattern as StudioCaseStudy.galleryImages. Capped at 4 in the Zod schemas
  // (products.ts/adminProducts.ts), not here.
  previewImages      String[]           @default([])
  // Optional demo/preview clip shown on /store/[id] alongside the gallery —
  // either an uploaded MP4/MOV (plain public Bunny CDN URL, same convention
  // as imageUrl/previewImages, capped at 50MB by videoUpload in
  // middleware/productUploads.ts) or a pasted YouTube/Vimeo link (validated
  // as a URL only, same posture as StudioCaseStudy.videoUrl). Rendering
  // (VideoEmbed.tsx) tells the two apart by parsing the URL shape, not by a
  // separate flag here.
  previewVideoUrl    String?
  // Optional admin-authored override for the "How it Works" 3-step panel on
  // /store/[id] — an array of exactly 3 { icon, titleKa, titleEn, bodyKa,
  // bodyEn } objects (validated in adminProducts.ts's zod schema, not here).
  // Null (the default for every existing product) means the page keeps
  // using its generic hardcoded copy — this only exists so an admin can
  // customize the panel for a specific listing (originally: the seeded AI
  // Business Assistant trial product) without a code change/deploy.
  howItWorksSteps    Json?
  // Never exposed directly to the client until a completed purchase is
  // verified server-side — see routes/products.ts's /:id/download. Uploads
  // made through /upload-file store a `cdcblob://<blobName>` marker here
  // instead of a real URL — privateBlobStorage.ts's isPrivateBlobRef()/
  // resolveDeliveryUrl() mint a short-lived signed URL from it on demand.
  // Pre-migration rows (or an admin who pasted an external URL directly)
  // keep a plain URL, returned as-is — same protection level those had
  // before this existed, not a regression.
  fileUrl            String
  downloadsCount     Int                @default(0)
  // Denormalized rollup of ProductPurchase rows that reached COMPLETED —
  // same "avoid an aggregate query on every list read" posture as
  // User.averageRating/reviewCount elsewhere in this schema. Incremented
  // exactly once per genuine new completion (productSaleService.ts's
  // completeProductPurchase and products.ts's free /:id/claim), never on a
  // retry of an already-COMPLETED purchase.
  salesCount         Int                @default(0)
  createdAt          DateTime           @default(now())
  purchases          ProductPurchase[]
  // Usage terms attached to this listing — snapshotted onto ProductPurchase
  // at fulfillment time (see productSaleService.ts). Defaults to the most
  // restrictive option so an admin/submitter has to deliberately opt into a
  // broader license rather than one being granted by omission.
  licenseType        ProductLicenseType @default(PERSONAL_USE)
  // "PENDING" | "APPROVED" | "REJECTED" | "NEEDS_REVISION" — admin-created
  // products (see adminProducts.ts) are inserted as APPROVED directly;
  // graduate/verified-freelancer submissions (products.ts's POST /) start
  // PENDING (or land directly on APPROVED/NEEDS_REVISION when
  // productModerationService's AI review is confident enough — see
  // aiReview* fields below) and only show up in the public catalog once
  // APPROVED.
  status             String             @default("PENDING")
  rejectionReason    String?
  // AI moderation (services/productModerationService.ts), run once at
  // submission/resubmission time — never re-run automatically afterward, so
  // these reflect the review that actually decided (or informed) the
  // current status, not a live/rolling score. Null on admin-authored
  // products (adminProducts.ts's POST / never invokes the moderator) and on
  // any submission made while GEMINI_API_KEY isn't configured or the
  // moderation call itself failed — both fall back to plain PENDING for a
  // human to review, exactly as if this feature didn't exist.
  aiReviewScore      Int?
  aiReviewConfidence Int?
  aiReviewReasoning  String?
  aiReviewedAt       DateTime?
  submittedById      String?
  submittedBy        User?              @relation("SubmittedProducts", fields: [submittedById], references: [id], onDelete: SetNull)
  launchKits         LaunchKit[]
  // Denormalized rollup of `reviews` (ProductReview), same pattern as
  // User.averageRating/reviewCount — recomputed on every review create/delete.
  averageRating      Float?
  reviewCount        Int                @default(0)
  reviews            ProductReview[]

  @@map("digital_products")
}

// ============================================================
// CDC CYBER SENTINEL AI — schema placeholder only. No routes, service, or
// upload/download mechanism exists yet for the actual desktop agent (see
// pages/tools.tsx's "მალე"/Coming Soon card) — this just reserves the shape
// a future desktop-client registration would need, so the eventual backend
// work has somewhere to start from.
// ============================================================
model CyberSentinelDevice {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("CyberSentinelDevices", fields: [userId], references: [id], onDelete: Cascade)
  deviceName   String
  os           String // "WINDOWS" | "MAC"
  agentVersion String?
  registeredAt DateTime  @default(now())
  lastSeenAt   DateTime?
  isActive     Boolean   @default(true)

  @@index([userId])
  @@map("cyber_sentinel_devices")
}

// Pre-launch lead capture from the "Get Early Access" modal on the /tools
// "მალე" card — deliberately separate from CyberSentinelDevice above:
// this is an anonymous visitor expressing interest (no account, no actual
// software), not a registered installation. No status/review workflow
// (unlike StudioInquiry) — a waitlist signup doesn't need one, just a list
// for launch-day outreach (see routes/adminCyberSentinel.ts).
model CyberSentinelWaitlistEntry {
  id        String   @id @default(uuid())
  name      String
  email     String
  os        String // "WINDOWS" | "MAC" | "LINUX"
  createdAt DateTime @default(now())

  @@map("cyber_sentinel_waitlist_entries")
}

// Singleton (one row, same convention as BogSettings) — admin-adjustable
// knobs for the platform's autonomous AI agents. Grouped into one table
// rather than one-per-agent since every knob here shares the same shape
// (an admin toggling/tuning how much an AI agent gets to act unattended).
model AiAutomationSettings {
  id String @id @default(uuid())

  // productModerationService.ts — both thresholds must be met (score AND
  // confidence) for an auto-APPROVED verdict; raising either makes
  // auto-approval rarer and pushes more submissions to NEEDS_REVISION/human
  // PENDING review instead — the safe direction to err in, since a wrongly-
  // published listing is far more visible/costly than an extra manual review.
  autoApproveScoreThreshold      Int @default(85)
  autoApproveConfidenceThreshold Int @default(85)

  // blogAgentService.ts's twice-weekly cron draft — false (default) means
  // every AI-generated article lands as an unpublished draft for an admin
  // to review before it goes live (today's only behavior, unchanged unless
  // an admin deliberately opts in here).
  blogAutoPublish Boolean @default(false)

  // grantScoutService.ts's daily cron scan. false (default) keeps every
  // scraped opportunity visible on /admin/opportunities, including
  // NOT_ELIGIBLE ones, until an admin archives it themselves — true hides
  // NOT_ELIGIBLE rows from the default view automatically.
  grantScoutAutoArchiveIneligible Boolean @default(false)
  // Whether notifyAdmins() fires (same Notification-based admin broadcast
  // as blogAgentService.ts) when a scan finds a NEW opportunity that comes
  // back ELIGIBLE. Only fires once per opportunity (on first insert, not
  // on every rescan of an already-seen listing) — see grantScoutService.ts.
  grantScoutNotifyOnMatch         Boolean @default(true)

  updatedByEmail String?
  updatedAt      DateTime @updatedAt

  @@map("ai_automation_settings")
}

model ProductPurchase {
  id               String              @id @default(uuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  product          DigitalProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  amount           Int
  // "PENDING" | "COMPLETED" — mirrors BogPayment.status naming for the
  // paid path; free (price=0) products are inserted directly as COMPLETED.
  paymentStatus    String              @default("PENDING")
  // Creator payout split — set only when the product has a real external
  // creator (DigitalProduct.submittedById; admin-catalog products have
  // none and keep the full amount with the platform). Null on free claims
  // and on admin-catalog purchases. See services/productSaleService.ts.
  commissionRate   Float?
  commissionAmount Int?
  netAmount        Int?
  // Snapshot of DigitalProduct.licenseType at the moment this purchase was
  // completed (see productSaleService.ts's completeProductPurchase and
  // products.ts's free /:id/claim) — nullable only because purchases made
  // before this field existed have no snapshot to backfill from; every
  // purchase completed from here on always sets it.
  licenseType      ProductLicenseType?
  // Set the first time this buyer actually downloads the file (see
  // GET /products/:id/download) — lets an admin see whether a refund
  // request came in before or after the file was ever opened. Never reset
  // on subsequent re-downloads (lifetime re-download is allowed).
  downloadedAt     DateTime?
  createdAt        DateTime            @default(now())
  // The review left against this specific purchase, if any — see
  // ProductReview.purchaseId, which is how "Verified Buyer" is enforced
  // (one review per completed purchase, never per user-product pair alone).
  review           ProductReview?

  @@unique([userId, productId])
  @@index([userId])
  @@map("product_purchases")
}

// ============================================================
// COURSE ENROLLMENT (individual purchase access — separate from `Order`,
// which is the pre-existing B2B bulk-seat model; this is one student buying
// access to one course via BOG checkout)
// ============================================================

model CourseEnrollment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  grantedAt DateTime @default(now())

  @@unique([userId, courseId])
  @@map("course_enrollments")
}

// ============================================================
// COURSE DISCUSSION — per-course Q&A on the /learn player, deliberately
// separate from the site-wide ForumThread/ForumComment above: different
// audience (enrolled students only, checked the same way as curriculum
// access — see routes/courses.ts's checkCourseAccess), and different
// moderation model (instant AI safety check on submit via
// contentModerationService, not a human pre-approval queue). One level of
// replies only (parentId), not deep threading — this is course Q&A, not a
// general discussion board.
// ============================================================
model CourseDiscussionPost {
  id        String                 @id @default(uuid())
  courseId  String
  course    Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    CourseDiscussionPost?  @relation("CourseDiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CourseDiscussionPost[] @relation("CourseDiscussionReplies")
  content   String
  createdAt DateTime               @default(now())

  @@index([courseId])
  @@index([parentId])
  @@map("course_discussion_posts")
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id           String      @id @default(uuid())
  enterprise   String
  contactEmail String
  courses      Course[]    @relation("OrderCourses")
  quantity     Int
  totalPrice   Int
  status       OrderStatus @default(Pending)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@map("orders")
}

// ============================================================
// BLOG POST
// ============================================================

// Video Tutorials / Help Center — short how-to videos (YouTube/Vimeo/Loom
// links, not hosted files) shown on the public /tutorials page and managed
// by SUPER_ADMIN/MANAGER via /admin/tutorials. Deliberately its own model
// rather than reusing BlogPost: no rich content/comments/authorship, just a
// title+description+video link, closer to StudioCaseStudy's shape.
model Tutorial {
  id            String    @id @default(uuid())
  title         String
  description   String
  category      String
  // Raw YouTube/Vimeo/Loom watch/share URL as pasted by the admin — turned
  // into an embeddable player URL client-side (see Frontend's
  // tutorialService.ts), not normalized at write time, so the admin form can
  // keep showing back exactly what was entered.
  videoUrl      String
  titleEn       String?
  descriptionEn String?
  // Manual sort position within a category — lower first. Admin-set, no
  // uniqueness constraint (ties just fall back to createdAt below).
  order         Int       @default(0)
  // Null = draft, not shown on the public page. Non-null = published, and
  // doubles as the "recently added" sort key — same nullable-DateTime-as-
  // gate convention as User.emailVerifiedAt/termsAcceptedAt.
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // At most one tutorial is ever featured at a time — the homepage's "▶
  // გაიგე როგორ მუშაობს პლატფორმა" button opens whichever one has this set
  // (see routes/tutorials.ts's GET /?featured=true). Setting this true on
  // one row unsets it on every other row in the same request, enforced in
  // the route handler rather than a DB constraint (same posture as
  // PaymentMethod.isDefault). A tutorial can be both featured and belong
  // to one of the public category sections at once — the two are
  // independent.
  isFeatured    Boolean   @default(false)

  @@index([category])
  @@index([publishedAt])
  @@map("tutorials")
}

model BlogPost {
  id                 String   @id @default(uuid())
  // title/description/content are the Georgian (primary) copy — matches all
  // existing rows. The *En twins are optional; public pages fall back to the
  // Georgian fields when the English ones are unset (see /admin/blog's
  // Auto-Translate button and pages/blog's rendering).
  title              String
  description        String
  category           String
  content            String
  titleEn            String?
  descriptionEn      String?
  contentEn          String?
  imageUrl           String?
  authorId           String
  author             User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  published          Boolean  @default(true)
  // Set by the AI agent (manual "✨ Generate" button or the twice-weekly
  // cron draft) — never by a human-authored post. Lets the admin UI badge
  // agent-drafted posts and filter them separately. See services/aiAgentService.ts.
  generatedByAgent   Boolean  @default(false)
  agentPromptContext String?
  // URL-friendly identifier for /blog/[slug], auto-generated from the
  // Georgian title at creation (see routes/blog.ts's slugify) and never
  // regenerated on a later title edit — a live post's URL must stay
  // stable, not shift under anyone who already bookmarked/shared it.
  // Nullable + not unique-enforced-at-the-DB-level would be simpler, but a
  // real unique constraint is what actually prevents a race from ever
  // creating two posts with the same slug.
  slug               String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  comments BlogComment[]

  @@index([category])
  @@index([published])
  @@map("blog_posts")
}

// ============================================================
// BLOG COMMENT — one level deep (a comment can reply to a post OR to
// another comment via parentId), authenticated users only. Moderation is
// deletion-only (no edit/hide state) via /admin/blog's moderation panel —
// matches the brief's "review or delete comments," and a soft-hide state
// would just be unused complexity without a "restore" UI anywhere.
// ============================================================

model BlogComment {
  id        String        @id @default(uuid())
  postId    String
  post      BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  parentId  String?
  parent    BlogComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   BlogComment[] @relation("CommentReplies")
  createdAt DateTime      @default(now())

  @@index([postId])
  @@index([parentId])
  @@map("blog_comments")
}

// ============================================================
// REVIEW (two-way, Upwork-style — one per participant per completed gig)
// ============================================================

model Review {
  id         String     @id @default(uuid())
  gigId      String
  gig        Gig        @relation(fields: [gigId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User       @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Restrict)
  revieweeId String
  reviewee   User       @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Restrict)
  rating     Int
  comment    String
  type       ReviewType
  createdAt  DateTime   @default(now())

  // One review per (gig, reviewer) — a participant can only review a given
  // gig once, which is also how "already reviewed" is enforced server-side.
  @@unique([gigId, reviewerId])
  @@index([revieweeId])
  @@map("reviews")
}

// ============================================================
// PRODUCT REVIEW (Digital Store — Etsy/Amazon-style verified-purchase
// rating on a DigitalProduct, distinct from the gig-marketplace Review
// model above). Security rule lives here, not just in the UI: a review can
// only ever be created against a purchaseId that is (a) this reviewer's own
// ProductPurchase row and (b) paymentStatus COMPLETED — see routes/
// productReviews.ts. purchaseId is @unique so a purchase can never carry
// more than one review, which is the actual "already reviewed" guard
// (stronger than the [productId, userId] unique below, which just prevents
// a rare double-purchase from producing two reviews for the same product).
// ============================================================
model ProductReview {
  id           String                     @id @default(uuid())
  productId    String
  product      DigitalProduct             @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId       String
  user         User                       @relation("ProductReviewsGiven", fields: [userId], references: [id], onDelete: Cascade)
  purchaseId   String                     @unique
  purchase     ProductPurchase            @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String
  // Up to 3 optional proof/showcase photos (e.g. the finished product in
  // use) — same Bunny-Storage-CDN-URL convention as every other upload in
  // this codebase, never freely-settable arbitrary URLs. Capped at 3 in the
  // Zod schema (productReviewSchemas.ts), not here.
  images       String[]                   @default([])
  // Denormalized count of helpfulVotes below — recomputed on every vote
  // toggle, same rollup pattern used everywhere else in this schema.
  helpfulCount Int                        @default(0)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  helpfulVotes ProductReviewHelpfulVote[]

  @@unique([productId, userId])
  @@index([productId])
  @@map("product_reviews")
}

// One "helpful" vote per (review, user) — prevents a single user from
// inflating helpfulCount by repeat-clicking.
model ProductReviewHelpfulVote {
  id        String        @id @default(uuid())
  reviewId  String
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([reviewId, userId])
  @@map("product_review_helpful_votes")
}

// ============================================================
// DIRECT OFFER (client-initiated outreach to a specific freelancer —
// either attached to one of the client's own open gigs, or a standalone
// quick custom offer with no gig behind it yet)
// ============================================================

model DirectOffer {
  id           String            @id @default(uuid())
  clientId     String
  client       User              @relation("SentDirectOffers", fields: [clientId], references: [id], onDelete: Restrict)
  freelancerId String
  freelancer   User              @relation("ReceivedDirectOffers", fields: [freelancerId], references: [id], onDelete: Restrict)
  gigId        String?
  gig          Gig?              @relation(fields: [gigId], references: [id], onDelete: SetNull)
  title        String
  description  String
  budgetAmount Int
  currency     String            @db.Char(3)
  message      String
  status       DirectOfferStatus @default(pending)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([freelancerId])
  @@index([clientId])
  @@map("direct_offers")
}

// ============================================================
// MESSAGE (direct 1:1 chat between two users). Every message sent through
// routes/messages.ts's POST / is checked by sanitizeChatMessage
// (utils/sanitizeChatMessage.ts) server-side; a flagged message is BLOCKED
// entirely regardless of either participant's role — never stored here at
// all, logged to ChatFlag below instead — same hard-block posture as
// MentorChatMessage/MentorChatViolation. This means wasFiltered essentially
// never turns true for a NEW row created through that route going forward.
//
// The column still exists and can still be true because two other,
// unrelated call sites write directly to this table with the OLDER
// mask-in-place-and-still-send behavior, never having gone through
// routes/messages.ts at all: routes/vacancies.ts (a candidate's application
// cover note, delivered as a kickoff DM to the employer) and any historical
// row from before this hard-block change shipped. Changing those two
// direct-write call sites' posture was out of scope here — see the fresh
// ChatFlag model below for what covers the messages.ts path now, and
// routes/adminMessages.ts's existing wasFiltered-based audit view for
// what still covers those.
//
// Separately, Student<->Student pairs also need an ACCEPTED ChatRequest
// (below) before POST / will accept anything from them at all — see
// services/chatConsentService.ts for exactly when that gate applies.
// ============================================================

model Message {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)
  recipientId String
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Restrict)
  content     String
  wasFiltered Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([senderId, recipientId])
  @@index([recipientId, senderId])
  @@map("messages")
}

// ============================================================
// CHAT REQUEST — Request-First consent gate for Student<->Student direct
// messaging specifically (routes/messages.ts's POST / enforces this only
// when both sender and recipient have role Student; any other role
// combination — a Client, Mentor, or SuperAdmin on either side — keeps the
// platform's original open-messaging behavior, since those relationships
// already come with their own established channel: a gig/vacancy, a
// mentorship booking, admin support, etc). A prior Message already existing
// between the two users also bypasses this gate — the point is to stop an
// UNSOLICITED first contact, not to re-gate an already-ongoing, legitimate
// conversation that predates this feature.
// ============================================================

enum ChatRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ChatRequest {
  id           String            @id @default(uuid())
  senderId     String
  sender       User              @relation("ChatRequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId  String
  recipient    User              @relation("ChatRequestsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  status       ChatRequestStatus @default(PENDING)
  // Short note shown to the recipient when deciding whether to accept —
  // itself run through sanitizeChatMessage the same as any chat content,
  // since it's free text visible to a stranger before any consent exists.
  introMessage String?
  respondedAt  DateTime?
  createdAt    DateTime          @default(now())

  // One row per direction per pair — a REJECTED request can't be re-sent by
  // the same sender (routes/chatRequests.ts checks for an existing row in
  // either direction before creating one), though the original recipient
  // can still initiate their own request back if they change their mind —
  // that's a different row, the reverse direction, not blocked by this.
  @@unique([senderId, recipientId])
  @@index([recipientId, status])
  @@map("chat_requests")
}

// One row per BLOCKED off-platform-contact attempt in general Message
// traffic — the Student<->Student equivalent of MentorChatViolation, kept
// as its own separate model rather than merged into that one since the two
// guard entirely different relationships (a paid mentorship booking vs.
// unsolicited peer messaging) and this one additionally tracks admin
// review state for /admin/chat-moderation, which MentorChatViolation has
// no equivalent page for. Manual ban only — unlike MentorChatViolation's
// automatic 2-strike ban, an admin decides here (see routes/
// adminChatModeration.ts); nothing in this model auto-bans anyone.
// HIGH = a phone number, payment-specific term, or an actual evasion
// technique (verbal-number spelling, noise-character-separated digits)
// was involved — a deliberate circumvention attempt, not just a casual
// slip. MEDIUM = a plain direct match (bare email/IBAN, an obvious
// platform-name mention) with no evasion technique detected. Set once at
// write time by utils/sanitizeChatMessage.ts's detection, not re-derived.
enum ChatFlagSeverity {
  MEDIUM
  HIGH
}

model ChatFlag {
  id                String           @id @default(uuid())
  senderId          String
  sender            User             @relation("ChatFlagsAsSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId       String
  recipient         User             @relation("ChatFlagsAsRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  attemptedContent  String
  detectedReason    String
  severity          ChatFlagSeverity @default(MEDIUM)
  reviewedAt        DateTime?
  reviewedByAdminId String?
  reviewedByAdmin   User?            @relation("ChatFlagsReviewed", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  @@index([senderId])
  @@index([createdAt])
  @@map("chat_flags")
}

// ============================================================
// PAYMENT METHOD (view/delete only — there is no payment-processor
// integration in this app yet, so nothing can create one through the API;
// existing rows would come from a future Stripe/etc. integration or manual
// seeding, same as this endpoint's original frontend scaffold assumed)
// ============================================================

// Which gateway actually issued processorToken. STUB is the only one that
// ever runs real code today — see paymentGatewayService.ts's own comment for
// why (mirrors BogSettings below: the data model is ready for a real
// processor, nothing calls out to one yet).
enum PaymentProvider {
  STUB
  BOG
  // Real card-on-file tokenization — a Stripe PaymentMethod attached to the
  // user's Stripe Customer (see User.stripeCustomerId), verified server-side
  // via the Stripe API in paymentGatewayService.bindCard rather than the
  // STUB provider's format-only check.
  STRIPE
}

model PaymentMethod {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       PaymentProvider @default(STUB)
  processorToken String
  brand          String
  last4          String
  expiryMonth    Int
  expiryYear     Int
  isDefault      Boolean         @default(false)
  // Set the moment the gateway's $0 authorization hold succeeds (see
  // paymentGatewayService.bindCard) — a trial can only start against a card
  // with this set. Null means the bind attempt never completed verification.
  verifiedAt     DateTime?
  createdAt      DateTime        @default(now())

  billingSubscriptions BillingSubscription[]

  @@index([userId])
  @@map("payment_methods")
}

// ============================================================
// BILLING SETTINGS — admin-configurable pricing knobs, single-row app-wide
// singleton. Same pattern as BogSettings below: kept out of hardcoded
// constants so pricing can change without a deploy. baseFeeTetri/
// marginMultiplier are read fresh on every trial-start/usage-record call,
// never cached, so an admin change takes effect on the very next request.
// ============================================================
model BillingSettings {
  id                      String   @id @default(uuid())
  // Minor units (tetri) — 9900 = 99.00 GEL/month, same convention as
  // Course.originalPrice / mentorHourlyRate. Charged once per active
  // BillingSubscription per billing cycle, on top of usage.
  baseFeeTetri            Int      @default(9900)
  // Multiplier applied to raw AI provider cost to get the billed usage cost
  // (see UsageRecord.marginMultiplier — frozen per-row at record time so a
  // later change here never rewrites past usage history).
  marginMultiplier        Float    @default(3.0)
  trialDays               Int      @default(10)
  // Manual bank-transfer alternative for users who don't want to attach a
  // card — shown read-only wherever card-attachment happens (see
  // PaymentMethodsCard.tsx) whenever an admin has actually filled these in.
  // Null (the default) means the option simply doesn't render — CDC never
  // fabricates banking details client-side.
  bankTransferIban        String?
  bankTransferBankName    String?
  bankTransferAccountName String?
  updatedByEmail          String?
  updatedAt               DateTime @updatedAt

  @@map("billing_settings")
}

// Platform-wide anti-spam/monetization knob for the free Vacancy/Gig posting
// flow — see Backend/src/services/postingLimitService.ts. Same
// singleton-row, fall-back-to-default-when-no-row-exists pattern as
// BillingSettings/BogSettings above.
model PlatformSettings {
  id             String   @id @default(uuid())
  dailyPostLimit Int      @default(3)
  updatedByEmail String?
  updatedAt      DateTime @updatedAt

  @@map("platform_settings")
}

// Service lines whose platform commission used to be a hardcoded constant
// duplicated across 4 independent services (escrowService.ts,
// mentorshipEscrowService.ts, hrSupportEscrowService.ts,
// productSaleService.ts) — now a SuperAdmin-editable row per service type,
// read via Backend/src/services/platformFeeScheduleService.ts. Each service
// still locks its rate in at capture time (never re-derived at
// release/payout), so a rate change here only affects transactions captured
// after the change.
model PlatformFeeSchedule {
  id                   String                 @id @default(uuid())
  serviceType          PlatformFeeServiceType @unique
  // Whole percentage points, e.g. 25 = 25%, not a 0-1 fraction — matches how
  // the admin UI displays and edits it.
  commissionPercentage Float
  updatedByEmail       String?
  updatedAt            DateTime               @updatedAt

  @@map("platform_fee_schedule")
}

enum PlatformFeeServiceType {
  // escrowService.ts — freelancer has NOT met hasFreelancerRights().
  GIG_UNVERIFIED
  // escrowService.ts — freelancer has met hasFreelancerRights().
  GIG_VERIFIED
  // mentorshipEscrowService.ts — flat rate, no verified/unverified split.
  MENTORSHIP
  // hrSupportEscrowService.ts — flat rate.
  HR_SUPPORT
  // productSaleService.ts — flat rate, only charged when the product has a
  // real external creator (submittedById).
  DIGITAL_PRODUCT
}

enum BillingProductType {
  // Frontend's /dashboard/ai-tools chat agents (see Agent model).
  // referenceId on the subscription below points at the specific Agent.id.
  AI_AGENT_SUITE
  // AI Proctored Exam & Skill Assessment System (see ExamSession model).
  // referenceId points at the specific ExamSession.id — one subscription
  // per exam session, same "99 GEL/month per active business tool" shape.
  AI_EXAM_PROCTORING
}

enum BillingSubscriptionStatus {
  // Card bound + $0-verified, within the trialDays window — usage is still
  // tracked (see UsageRecord) but nothing is charged.
  TRIALING
  // Trial passed with autoRenew on and a verified default payment method —
  // still "non-invasive" in the same sense as agentBillingService's existing
  // trial-expiry sweep: no real charge is ever attempted (see
  // paymentGatewayService's own comment), this just tracks intent/state.
  ACTIVE
  // Trial (or a period) ended with no verified payment method / autoRenew
  // off — mirrors Agent.status's existing PAUSED semantics.
  PAST_DUE
  CANCELED
}

// One row per (business, tool) subscription — productType + referenceId is
// a polymorphic pointer, same pattern as BogPayment's purpose + referenceId
// below, since AI_AGENT_SUITE is the only product today but more will
// follow the same "99 GEL/month per active business tool" shape.
model BillingSubscription {
  id                    String                    @id @default(uuid())
  businessId            String
  business              User                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productType           BillingProductType
  referenceId           String
  status                BillingSubscriptionStatus @default(TRIALING)
  // Snapshot of BillingSettings.baseFeeTetri at subscription-start time —
  // deliberately NOT re-read live, so an admin pricing change never
  // retroactively alters an already-running subscription's base fee.
  baseFeeTetri          Int
  trialEndsAt           DateTime
  currentPeriodStart    DateTime                  @default(now())
  currentPeriodEnd      DateTime?
  autoRenew             Boolean                   @default(true)
  paymentMethodId       String?
  paymentMethod         PaymentMethod?            @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  // Set once, the first time sweepTrialEndingWarnings fires the "1 day
  // left" notice for this trial — never re-sent, even across sweep runs.
  trialWarningSentAt    DateTime?
  // Set once per billing cycle, the first time sweepRenewalReminders fires
  // the pre-debit notice ahead of currentPeriodEnd — cleared on each
  // rolloverActiveBillingPeriods advance so the next cycle gets its own.
  renewalReminderSentAt DateTime?
  canceledAt            DateTime?
  cancellationReason    String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  usageRecords UsageRecord[]

  @@unique([businessId, productType, referenceId])
  @@index([businessId])
  @@map("billing_subscriptions")
}

enum UsageEventType {
  AI_AGENT_EXECUTION
  // AI grading of one ExamSubmission's practical/open-ended answer (see
  // examProctoringService.gradePracticalAnswer) — question generation
  // itself isn't metered, only per-candidate grading calls, since that's
  // the part that scales with how many candidates a business screens.
  EXAM_GRADING
}

// One row per billable AI Agent execution (POST /api/v1/chat, see
// routes/chatApi.ts) — token counts come straight from the Gemini response's
// usageMetadata (see businessAiChatService.ts).
model UsageRecord {
  id               String              @id @default(uuid())
  subscriptionId   String
  subscription     BillingSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  agentId          String?
  agent            Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  examSubmissionId String?
  examSubmission   ExamSubmission?     @relation(fields: [examSubmissionId], references: [id], onDelete: SetNull)
  eventType        UsageEventType      @default(AI_AGENT_EXECUTION)
  promptTokens     Int                 @default(0)
  completionTokens Int                 @default(0)
  totalTokens      Int                 @default(0)
  // Raw provider cost in tetri, before margin — see billingService's
  // AI_TOKEN_RATE_TETRI_PER_1K constant (placeholder rate; not a real
  // Gemini invoice figure, same "no real gateway wired up" posture as the
  // rest of this file).
  rawCostTetri     Int                 @default(0)
  // rawCostTetri * marginMultiplier, rounded — the actual amount owed for
  // this execution. marginMultiplier is frozen here from BillingSettings at
  // record time (see that model's own comment on why).
  billedCostTetri  Int                 @default(0)
  marginMultiplier Float               @default(3.0)
  createdAt        DateTime            @default(now())

  @@index([subscriptionId])
  @@index([agentId])
  @@index([examSubmissionId])
  @@map("usage_records")
}

// ============================================================
// AI PROCTORED EXAM & SKILL ASSESSMENT SYSTEM
//
// A Business creates an ExamSession (AI-generates a fixed question set once,
// stored as ExamQuestion rows so every candidate sees the identical set —
// deliberately NOT regenerated per-candidate like SkillTestAttempt/
// FreelancerSkillExamAttempt, since fair candidate comparison requires the
// same questions). candidateToken is the public, unguessable link a
// business shares — no CDC account required to take the exam, same
// anonymous-visitor posture as Agent's public chat widget.
//
// "Real-time behavioral proctoring" here means what freelancerExam.ts's
// existing strike system already proves out in production — tab-switch /
// fullscreen-exit / copy-paste violations counted client-side during the
// live session and reported on submit — NOT webcam/video analysis, which
// is a materially different (and much larger) feature this doesn't attempt.
// ============================================================

enum ExamSessionStatus {
  ACTIVE
  CLOSED
}

model ExamSession {
  id              String            @id @default(uuid())
  businessId      String
  business        User              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  // Free-text steer for the AI question generator, e.g. "Senior React
  // Developer — hooks, state management, performance" — same role as
  // Exam.aiPromptContext elsewhere in this schema.
  topic           String
  // Parsed Markdown text from an optional PDF/DOCX exam-source upload (see
  // documentParserService.parseDocumentToMarkdown, same parser used for
  // Agent knowledge uploads) — appended to `topic` as extra grounding
  // context for the AI question generator when present. Null when the exam
  // was created from `topic` alone with no file.
  rawContent      String?
  mcqCount        Int               @default(5)
  durationMinutes Int               @default(30)
  status          ExamSessionStatus @default(ACTIVE)
  // Public shareable link uses this, never the real id — same reasoning as
  // AgentConversation.visitorRef being client-opaque, but here it's the
  // session itself that must not be guessable/enumerable.
  candidateToken  String            @unique @default(uuid())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  questions   ExamQuestion[]
  submissions ExamSubmission[]
  // Retest exams generated by generateAdaptiveRetest() — a fresh
  // ExamSession cloned from the original attempt's weak topics, linked back
  // from the AdaptiveStudyGuide that spawned it.
  retestFor   AdaptiveStudyGuide[] @relation("RetestExam")

  @@index([businessId])
  @@map("exam_sessions")
}

enum ExamQuestionType {
  MCQ
  PRACTICAL
  // AI-graded like PRACTICAL (same rubric-based gradePracticalAnswer flow)
  // but rendered candidate-side in a monospace editor-style textarea
  // instead of a plain paragraph field.
  CODE
}

// Persisted once per ExamSession at creation time (not per-attempt) — see
// the section comment above for why. correctAnswer/rubric are never sent to
// the public candidate-facing routes/examProctoring.ts, only used server-side
// at grading time — same posture as every other exam model in this schema.
model ExamQuestion {
  id            String           @id @default(uuid())
  examSessionId String
  examSession   ExamSession      @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  order         Int
  type          ExamQuestionType
  question      String
  // MCQ only: {"A": "...", "B": "...", "C": "...", "D": "..."}. Null for PRACTICAL.
  options       Json?
  // MCQ: the correct letter (A-D). PRACTICAL/CODE: the AI grading rubric —
  // same dual-purpose-by-type shape as SkillQuestion in skillTestService.ts,
  // just persisted instead of regenerated per attempt.
  correctAnswer String?
  // Relative scoring weight (e.g. a harder question worth more toward
  // totalScore) — defaults to 1 (all questions equal), same "opt-in
  // complexity" posture as Course.originalPrice-style defaults elsewhere.
  weight        Int              @default(1)
  createdAt     DateTime         @default(now())

  @@index([examSessionId])
  @@map("exam_questions")
}

enum ExamSubmissionStatus {
  IN_PROGRESS
  COMPLETED
  // Force-submitted for hitting the proctoring strike limit — same
  // "disqualified" concept as freelancerExam.ts, named for what a business
  // reviewing candidate reports actually needs to see at a glance.
  FLAGGED
}

// One row per candidate attempt — candidateToken (not examSessionId alone)
// is how the candidate-facing routes address their own in-progress
// submission, so one candidate's answers/timer are never guessable from
// another's.
model ExamSubmission {
  id                   String               @id @default(uuid())
  examSessionId        String
  examSession          ExamSession          @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  candidateName        String
  candidateEmail       String
  candidateToken       String               @unique @default(uuid())
  // { [questionId]: "A"|"B"|"C"|"D" } for MCQ, plus the practical question's
  // free-text answer under its own id — one JSON blob, same convention as
  // FreelancerSkillExamAttempt.answers.
  answers              Json?
  mcqScore             Float?
  practicalScore       Float?
  totalScore           Float?
  // AI's written feedback on the practical answer (gradePracticalAnswer) —
  // shown to the business in the candidate report, not the candidate.
  aiEvaluation         String?
  // Combined violation count — still the FLAG_THRESHOLD source of truth in
  // routes/examProctoring.ts. tabSwitches/copyPasteCount below are the same
  // events broken out by kind for the business's proctoring report; every
  // increment of either also increments this one. All three are written
  // once, at submit time, recomputed server-side from this submission's
  // ProctoringEvent rows — never taken from the client's submit request
  // body, which a candidate calling the API directly could set to anything.
  proctoringViolations Int                  @default(0)
  tabSwitches          Int                  @default(0)
  copyPasteCount       Int                  @default(0)
  // 100 minus a penalty per proctoring violation, floored at 0 — a single
  // at-a-glance number for the business report; the raw counts above stay
  // available for detail. Null until the attempt is submitted.
  integrityScore       Float?
  // Best-effort AI estimate (0-100) of how likely the candidate's
  // PRACTICAL/CODE answers were AI-generated rather than self-written —
  // heuristic, not a certainty (LLM writing-pattern classification has no
  // ground truth to validate against), surfaced to the business as an
  // advisory signal alongside the human-reviewable answer text itself,
  // never as an automatic disqualification. Null when there were no
  // PRACTICAL/CODE questions to assess.
  aiTextScore          Float?
  // Per-question grading detail — [{questionId, candidateAnswer, aiScore,
  // aiFeedback, aiTextScore}] for every PRACTICAL/CODE question, the basis
  // for AdaptiveStudyGuide's weakTopics. JSON blob rather than a child
  // table, same convention as `answers` above and every other exam model in
  // this schema (Exam.ExamAttempt.questions, SkillTestAttempt.questions) —
  // always read as a whole alongside its one parent submission, never
  // queried across submissions.
  answerGrades         Json?
  status               ExamSubmissionStatus @default(IN_PROGRESS)
  startedAt            DateTime             @default(now())
  completedAt          DateTime?

  usageRecords     UsageRecord[]
  studyGuide       AdaptiveStudyGuide?
  proctoringEvents ProctoringEvent[]

  @@index([examSessionId])
  @@map("exam_submissions")
}

enum ProctoringEventType {
  TAB_SWITCH
  COPY_PASTE
}

// One row per candidate-reported violation, timestamped by server receipt
// (occurredAt), not by the client — the record POST /submissions/:token/submit
// recomputes tabSwitches/copyPasteCount/proctoringViolations from, instead
// of trusting whatever counts the submit request body claims. The candidate
// token is the same opaque-UUID trust boundary already used for every other
// candidate-facing route in examProctoring.ts, so this doesn't weaken
// anything — it just moves the count itself out of client control.
model ProctoringEvent {
  id           String              @id @default(uuid())
  submissionId String
  submission   ExamSubmission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type         ProctoringEventType
  occurredAt   DateTime            @default(now())

  @@index([submissionId])
  @@map("proctoring_events")
}

// Generated once a COMPLETED/FLAGGED submission scores below the pass mark
// on specific topics (see examProctoringService.generateAdaptiveStudyGuide)
// — an AI-written micro study guide targeting exactly those weak spots,
// plus an optional freshly-generated retest ExamSession scoped to the same
// topics. One-to-one with the submission it was generated for.
model AdaptiveStudyGuide {
  id                  String         @id @default(uuid())
  examSubmissionId    String         @unique
  examSubmission      ExamSubmission @relation(fields: [examSubmissionId], references: [id], onDelete: Cascade)
  candidateEmail      String
  // string[] of the specific question topics/skills the candidate scored
  // below threshold on — drives both the guide text and the retest's topic.
  weakTopics          Json
  generatedGuideText  String
  retestExamSessionId String?
  retestExamSession   ExamSession?   @relation("RetestExam", fields: [retestExamSessionId], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())

  @@map("adaptive_study_guides")
}

// ============================================================
// BOG SETTINGS (Bank of Georgia payment gateway config — SUPER_ADMIN only)
//
// Backs a real, live BOG merchant integration — see
// services/bogPaymentService.ts, which authenticates via OAuth2
// client_credentials against BOG's Online Payment API and verifies callback
// signatures against BOG's published RSA public key. This model is the
// config store the admin panel reads/writes credentials through (env vars
// BOG_CLIENT_ID/BOG_SECRET_KEY take priority over these when set — see
// bogPaymentService.ts); secretKey/webhookSecret are never echoed back in
// full once set (masked, same principle as never returning a password
// hash). A single row is used as an app-wide singleton — the service layer
// enforces that, not the schema. Note: isLiveMode below is informational
// only (surfaced in the admin panel) — bogPaymentService.ts does not read
// it and always targets BOG's production API domains regardless.
// ============================================================

model BogSettings {
  id             String   @id @default(uuid())
  // OAuth2 client_credentials — matches BOG's real Online Payment API
  // (POST https://oauth2.bog.ge/auth/realms/bog/protocol/openid-connect/token,
  // Basic auth of clientId:secretKey). Renamed from merchantId/publicKey/
  // webhookSecret (this session's earlier guess before the real API contract
  // was confirmed) — BOG doesn't take a separate "merchant id" or "our public
  // key," and callback authenticity is verified against BOG's own published
  // RSA public key (hardcoded in bogPaymentService.ts), not a shared secret.
  clientId       String?
  secretKey      String?
  isLiveMode     Boolean  @default(false)
  updatedByEmail String?
  updatedAt      DateTime @updatedAt

  @@map("bog_settings")
}

// ============================================================
// BOG PAYMENT (one row per BOG order, across all three checkout flows —
// purpose + referenceId is a lightweight polymorphic pointer rather than
// three near-identical tables, since the payment lifecycle itself — create
// order, await callback, mark completed/failed — is identical regardless of
// what's being paid for)
// ============================================================

model BogPayment {
  id                String             @id @default(uuid())
  bogOrderId        String             @unique
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose           BogPaymentPurpose
  // COURSE -> Course.id, MENTORSHIP -> Mentor's User.id (see
  // MentorshipBooking for the actual scheduling details), GIG_ESCROW_FUNDING -> Gig.id
  referenceId       String
  amount            Int // minor units
  currency          String             @db.Char(3)
  status            BogPaymentStatus   @default(PENDING)
  redirectUrl       String?
  // Last callback payload received from BOG, kept for audit/debugging —
  // never trusted as the source of truth without signature verification.
  rawCallback       Json?
  createdAt         DateTime           @default(now())
  completedAt       DateTime?
  mentorshipBooking MentorshipBooking?
  // Promo code applied at checkout (COURSE purpose only, currently) — kept
  // for order-history/referral-commission tracking. SetNull rather than
  // Restrict/Cascade: deleting a PromoCode later must never block deleting
  // (or block existing) BogPayment rows that used it.
  promoCodeId       String?
  promoCode         PromoCode?         @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([purpose, referenceId])
  @@map("bog_payments")
}

// ============================================================
// STRIPE PAYMENT — the international-checkout counterpart to BogPayment
// (USD/EUR, non-Georgian users), kept as a fully separate table rather than
// widening BogPayment itself: this app has zero automated test coverage on
// the payment path, so the lower-risk choice is a parallel model + parallel
// fulfillment function (see routes/stripePayments.ts) rather than touching
// the BOG code real users already depend on. Reuses BogPaymentPurpose/
// BogPaymentStatus since the lifecycle concepts are identical, just the
// gateway differs.
// ============================================================
model StripePayment {
  id                    String             @id @default(uuid())
  stripeSessionId       String             @unique
  stripePaymentIntentId String?
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose               BogPaymentPurpose
  referenceId           String
  amount                Int // minor units
  currency              String             @db.Char(3)
  status                BogPaymentStatus   @default(PENDING)
  checkoutUrl           String?
  // Last webhook event payload received from Stripe, kept for audit/debugging
  // — never trusted as the source of truth without signature verification.
  rawEvent              Json?
  createdAt             DateTime           @default(now())
  completedAt           DateTime?
  mentorshipBooking     MentorshipBooking?
  promoCodeId           String?
  promoCode             PromoCode?         @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([purpose, referenceId])
  @@map("stripe_payments")
}

// A mentor's recurring weekly availability — e.g. "Tuesdays 18:00-22:00".
// Times are in the platform's fixed reference timezone (Asia/Tbilisi,
// matching CDC's actual operating hours) as minutes-since-midnight, not a
// specific date, so one rule covers every week going forward.
model MentorAvailabilityRule {
  id          String   @id @default(uuid())
  mentorId    String
  mentor      User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startMinute Int // minutes since midnight, e.g. 18:00 = 1080
  endMinute   Int
  createdAt   DateTime @default(now())

  @@index([mentorId])
  @@map("mentor_availability_rules")
}

// A single blocked calendar date (vacation, sick day, etc.) layered on top
// of MentorAvailabilityRule above — the recurring rules stay the source of
// truth for which weekly slots exist at all (removing them would leave
// nothing for generateAvailableSlots() to generate from), this just
// excludes one specific date from them. `date` is stored at Tbilisi
// midnight UTC — see mentorAvailabilityService.ts's own REFERENCE_TIMEZONE
// — and compared by calendar date, not exact instant.
model MentorAvailabilityException {
  id          String   @id @default(uuid())
  mentorId    String
  mentor      User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  date        DateTime
  // Both null = the whole day is blocked (original behavior). Both set =
  // only that minute range within the day is blocked, so a mentor can keep
  // the rest of the day bookable — see mentorAvailabilityService.ts's
  // partial-exception handling in generateMentorSlots/assertSlotAvailable.
  startMinute Int?
  endMinute   Int?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([mentorId, date])
  @@map("mentor_availability_exceptions")
}

// One row per paid mentorship session — created at checkout time (before
// payment completes) so the chosen slot/phone/description survive the BOG
// (or Stripe) redirect round-trip; the Google Calendar fields are filled in
// once applyBogPaymentResult()/applyStripePaymentResult() confirms payment
// and calls googleCalendarService. Exactly one of bogPaymentId/
// stripePaymentId is set per row (enforced in routes/payments.ts and
// routes/stripePayments.ts at booking-creation time, not a DB constraint —
// this app has no other dual-gateway rows to model that decision after).
model MentorshipBooking {
  id                      String         @id @default(uuid())
  bogPaymentId            String?        @unique
  bogPayment              BogPayment?    @relation(fields: [bogPaymentId], references: [id], onDelete: Cascade)
  stripePaymentId         String?        @unique
  stripePayment           StripePayment? @relation(fields: [stripePaymentId], references: [id], onDelete: Cascade)
  mentorId                String
  mentor                  User           @relation("MentorshipBookingsAsMentor", fields: [mentorId], references: [id], onDelete: Restrict)
  studentId               String
  student                 User           @relation("MentorshipBookingsAsStudent", fields: [studentId], references: [id], onDelete: Restrict)
  scheduledAt             DateTime
  studentPhone            String
  consultationDescription String?
  googleEventId           String?
  googleMeetLink          String?
  // Set when the Calendar API call fails/isn't configured — the booking and
  // payment are still valid either way, this is purely diagnostic so an
  // admin can see which sessions need a manual calendar invite.
  calendarSyncError       String?
  // Pasted link (Google Drive, Bunny CDN, direct MP4, etc.) to the session
  // recording — not a file we host ourselves, just an external URL an
  // admin or the mentor attaches after the session. recordingUploadedAt is
  // set alongside it (see services/mentorshipRecordingService.ts) and
  // drives the "recording ready" email to the student — never re-sent on
  // a later edit of an already-set URL, only on the first attach.
  recordingUrl            String?
  recordingUploadedAt     DateTime?
  // Locked in once the session payment is captured (see
  // services/mentorshipEscrowService.ts's captureMentorshipEscrow) — same
  // 20%/80% split as every other revenue stream on the platform
  // (escrowService.ts, productSaleService.ts). null until capture happens.
  // Note this is only ever computed at capture time, never re-derived —
  // netAmount is what actually gets credited to the mentor on release.
  commissionRate          Float?
  commissionAmount        Int?
  netAmount               Int?
  createdAt               DateTime       @default(now())
  // "SCHEDULED" | "CANCELLED" | "COMPLETED" — no cancel/completion tracking
  // existed before this field; COMPLETED is set lazily (GET /bookings/mine
  // flips any SCHEDULED booking whose scheduledAt has passed) rather than by
  // a cron, since nothing else in this session time-sensitively needs it
  // set the instant the session ends.
  status                  String         @default("SCHEDULED")
  // ============================================================
  // ESCROW LIFECYCLE — mirrors GigTransaction's HELD_IN_ESCROW/RELEASED/
  // REFUNDED shape (escrowService.ts), just inlined onto the booking row
  // instead of a separate transaction model, matching how this model
  // already combines "booking" and "transaction" in one place. Null until
  // payment is captured (see mentorshipEscrowService.ts); a booking whose
  // payment never completes never gets an escrowStatus at all.
  // ============================================================
  escrowStatus            String?
  // Set at capture time = scheduledAt + session length + 24h grace period.
  // The auto-release sweep (autoReleaseMentorshipEscrows) only ever acts on
  // rows past this timestamp with no open dispute.
  autoReleaseAt           DateTime?
  releasedAt              DateTime?
  // "STUDENT_CONFIRMED" | "AUTO_RELEASE" | "ADMIN_RESOLVED"
  releaseTrigger          String?
  // Set by the student's own dispute action, OR automatically when a
  // booking with funds already in escrow is cancelled before the session
  // starts (see routes/mentorship.ts's cancel route) — either way, a
  // non-null disputeRaisedAt freezes the auto-release sweep until an admin
  // resolves it via resolveMentorshipDispute.
  disputeRaisedAt         DateTime?
  disputeReason           String?
  disputeResolvedAt       DateTime?
  // "RELEASE" | "REFUND"
  disputeResolution       String?

  walletEntries  WalletEntry[]
  history        MentorBookingHistory[]
  chatMessages   MentorChatMessage[]
  chatViolations MentorChatViolation[]

  @@index([mentorId])
  @@index([studentId])
  @@map("mentorship_bookings")
}

// Audit trail for MentorshipBooking's lifecycle — one row per state change,
// append-only (nothing here is ever updated/deleted). action is one of
// "CREATED" | "RESCHEDULED" | "CANCELLED" | "COMPLETED".
model MentorBookingHistory {
  id                  String            @id @default(uuid())
  bookingId           String
  booking             MentorshipBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  action              String
  // Null for the system-derived COMPLETED transition (GET /bookings/mine) —
  // every other action has a real actor.
  performedById       String?
  performedBy         User?             @relation("MentorBookingHistoryActor", fields: [performedById], references: [id], onDelete: SetNull)
  previousScheduledAt DateTime?
  newScheduledAt      DateTime?
  note                String?
  createdAt           DateTime          @default(now())

  @@index([bookingId])
  @@map("mentor_booking_history")
}

// In-app mentor <-> client chat, scoped to one booking — polling-based (no
// websocket infra in this codebase yet), see GET/POST
// /mentorship/bookings/:id/messages. Only ever created for messages that
// passed moderation (chatModerationService.ts) — a blocked attempt is
// logged to MentorChatViolation instead and never reaches this table.
model MentorChatMessage {
  id         String            @id @default(uuid())
  bookingId  String
  booking    MentorshipBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User              @relation("MentorChatMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User              @relation("MentorChatMessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime          @default(now())

  @@index([bookingId])
  @@map("mentor_chat_messages")
}

// One row per blocked off-platform-contact attempt (chatModerationService.ts)
// — counted per user across ALL their bookings, not per-booking, since this
// is about a user's overall conduct on the platform. The 2nd row for a given
// userId is what flips User.isBanned (see routes/mentorship.ts's POST
// .../messages) — requireApproved already enforces isBanned on every
// subsequent authenticated request, which is what actually "logs the
// offender out" in practice (no server-side session store to revoke a JWT
// from directly).
model MentorChatViolation {
  id               String            @id @default(uuid())
  bookingId        String
  booking          MentorshipBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId           String
  user             User              @relation("MentorChatViolations", fields: [userId], references: [id], onDelete: Cascade)
  attemptedContent String
  detectedReason   String
  createdAt        DateTime          @default(now())

  @@index([userId])
  @@map("mentor_chat_violations")
}

// ============================================================
// FORUM — categories, threads, comments, likes. New threads are
// pre-moderated (PENDING until a Mentor/SuperAdmin approves them);
// comments are not, matching the admin brief's "pending POSTS require
// approval" scope. Pin/lock are separate moderator actions available on
// already-approved threads.
// ============================================================

enum ForumModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model ForumCategory {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())

  threads ForumThread[]

  @@map("forum_categories")
}

model ForumThread {
  id         String        @id @default(uuid())
  categoryId String
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  title      String
  content    String

  moderationStatus ForumModerationStatus @default(PENDING)
  moderationReason String?
  moderatedAt      DateTime?
  isPinned         Boolean               @default(false)
  isLocked         Boolean               @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments ForumComment[]
  likes    ForumThreadLike[]

  @@index([categoryId])
  @@index([moderationStatus])
  @@map("forum_threads")
}

model ForumComment {
  id       String      @id @default(uuid())
  threadId String
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId String
  author   User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content  String

  createdAt DateTime @default(now())

  likes ForumCommentLike[]

  @@index([threadId])
  @@map("forum_comments")
}

model ForumThreadLike {
  id       String      @id @default(uuid())
  threadId String
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@map("forum_thread_likes")
}

model ForumCommentLike {
  id        String       @id @default(uuid())
  commentId String
  comment   ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("forum_comment_likes")
}

// ============================================================
// DISPUTES — opened by either party on a gig when work is incomplete or
// disputed. Resolution is a manual admin action (refund the client or
// release payout to the freelancer); no automatic money movement here,
// same posture as PayoutRequest below.
// ============================================================

enum DisputeStatus {
  OPEN
  RESOLVED_REFUND
  RESOLVED_PAYOUT
  DISMISSED
}

model Dispute {
  id    String @id @default(uuid())
  gigId String
  gig   Gig    @relation(fields: [gigId], references: [id], onDelete: Cascade)

  raisedById String
  raisedBy   User   @relation("DisputesRaised", fields: [raisedById], references: [id], onDelete: Restrict)
  reason     String

  status       DisputeStatus @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedBy   User?         @relation("DisputesResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([gigId])
  @@index([status])
  @@map("disputes")
}

// ============================================================
// PAYOUT REQUESTS — a student's ask to withdraw their earningsBalance to a
// bank account. This only tracks the request/approval workflow; approving
// one debits earningsBalance and writes a WalletEntry(PAYOUT_DEBIT), same
// as every other wallet mutation. As of the bogPayoutService design (see
// that file's own header comment), the actual transfer can now go one of
// two ways: a LOW-risk request is wired automatically via BOG's Mass
// Payout API, everything else still gets wired by hand outside the
// platform exactly as before (an admin wires the money via BOG's own
// dashboard/banking after approving).
// ============================================================

enum PayoutRequestStatus {
  PENDING
  APPROVED
  // Funds are claimed (see bogPayoutService.claimForProcessing) and the BOG
  // API call is either in flight or awaiting its confirmation webhook — a
  // request sits here only ever as long as that one call/webhook round
  // trip takes, never as a resting state. See bogPayoutService.ts's header
  // comment for the full state machine.
  PROCESSING
  REJECTED
  PAID
  // BOG rejected the transfer or the webhook never confirmed within the
  // timeout — earningsBalance has already been restored by the same
  // transaction that set this status (see bogPayoutService.markFailed).
  // Always routes to the Admin Review Queue; never silently retried.
  FAILED
}

// LOW passes every current auto-approval rule at request-creation time and
// is eligible for straight-through BOG Mass Payout processing.
// MANUAL_REVIEW fails one or more rules (or the engine isn't configured/
// enabled yet) and always requires a human SUPER_ADMIN approval, with no
// upper amount that exempts it — this is the fail-safe default the whole
// design leans on, see bogPayoutService.ts.
enum PayoutRiskTier {
  LOW
  MANUAL_REVIEW
}

model PayoutRequest {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("PayoutRequests", fields: [userId], references: [id], onDelete: Restrict)

  amount Int // minor units
  iban   String

  status       PayoutRequestStatus @default(PENDING)
  adminNote    String?
  reviewedById String?
  reviewedBy   User?               @relation("PayoutRequestsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  // Evaluated and locked in at request-creation time (evaluateRiskTier in
  // bogPayoutService.ts) — never re-derived later, same "lock in at capture
  // time" convention as every commission rate elsewhere in this schema.
  // A rule change only affects requests created after it, and the exact
  // rule outcome for an already-resolved request stays auditable forever.
  riskTier     PayoutRiskTier @default(MANUAL_REVIEW)
  autoApproved Boolean        @default(false)

  // Deterministic, generated once at creation as `payout_request_<id>` —
  // sent as BOG's own idempotency key on every call attempt for this
  // request, including retries, so a network timeout that actually
  // succeeded bank-side can never be double-submitted. @unique makes a
  // second PayoutRequest row physically incapable of reusing one, though
  // in practice the id-derived scheme already guarantees that on its own.
  idempotencyKey String @unique

  // BOG's own transfer/transaction id, set once their API (or its
  // confirmation webhook) actually returns one — the reconciliation anchor
  // for any manual lookup in BOG's own dashboard.
  providerRef String? @unique

  // Set when claimForProcessing's atomic claim succeeds — i.e. exactly
  // when funds left PENDING/APPROVED and got locked for the BOG call.
  processingStartedAt DateTime?
  failedAt            DateTime?
  failureReason       String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@map("payout_requests")
}

// ============================================================
// AUDIT LOG — append-only record of sensitive admin actions (bans, role
// changes, payout approvals, dispute resolutions, forum moderation, manual
// course grants, refunds). Written by services/auditLogService.ts.
// ============================================================

model AuditLog {
  id String @id @default(uuid())

  action        String // e.g. "user.ban", "payout.approve", "dispute.resolve"
  targetType    String // e.g. "User", "PayoutRequest", "ForumThread"
  targetId      String
  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id], onDelete: Restrict)
  metadata      Json?

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([performedById])
  @@map("audit_logs")
}

// ============================================================
// AI AGENT LOG — one row per CDC Autonomous Operations Agent run (blog
// draft generation, weekly admin digest, onboarding email), success or
// failure. No performedById FK like AuditLog above — an autonomous cron
// run has no human actor, so this is a separate table rather than
// overloading AuditLog's required performedById. Written by
// services/aiGenerationLogService.ts.
// ============================================================

model AiGenerationLog {
  id String @id @default(uuid())

  // e.g. "blog_manual" (admin clicked Generate), "blog_cron" (scheduled
  // draft), "weekly_digest", "onboarding_email".
  module        String
  status        String // "success" | "failed"
  inputContext  Json?
  outputSummary String?
  errorMessage  String?

  createdAt DateTime @default(now())

  @@index([module])
  @@index([createdAt])
  @@map("ai_generation_logs")
}

// ============================================================
// SITE CONTENT — simple per-page CMS store. One row per editable page
// ("homepage", "about", ...), content shape is page-specific and owned by
// the frontend (see pages/admin/cms/[page].tsx) — the backend just stores
// and serves the JSON blob, no schema validation on its internal shape
// beyond "it's an object".
// ============================================================

model SiteContent {
  id      String @id @default(uuid())
  page    String @unique
  content Json

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@map("site_content")
}

// ============================================================
// STUDIO INQUIRY — public lead-gen submissions from the CDC Studio
// (/agency) "Request a Project" form. No User relation for the
// submitter — these come from prospective clients who aren't necessarily
// platform accounts, so contact details are captured directly on the row,
// same posture as Order's enterprise/contactEmail fields.
// ============================================================

enum StudioInquiryStatus {
  PENDING
  IN_REVIEW
  ACCEPTED
  DECLINED
}

model StudioInquiry {
  id          String  @id @default(uuid())
  name        String
  email       String
  phone       String?
  company     String?
  projectType String
  budgetRange String?
  message     String

  status       StudioInquiryStatus @default(PENDING)
  adminNote    String?
  reviewedById String?
  reviewedBy   User?               @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@map("studio_inquiries")
}

// ============================================================
// CDC BUSINESS AI — embeddable AI chat agents that Business (Client)
// accounts configure and embed on their own external site via the public
// widget (see /public/widget.js and POST /api/v1/chat).
//
// Billing/subscription fields (trialEndsAt, status) live directly on Agent
// rather than a separate Subscription model for now: there's no BOG card
// tokenization wired up yet to populate a real Subscription's card-token
// fields, and a model that's mostly empty until that's built would just be
// premature structure. `status` only ever gets flipped to PAUSED by the
// trial-expiry cron (services/agentBillingService.ts) or an explicit user
// action — nothing here ever auto-charges a card.
// ============================================================

enum AgentStatus {
  TRIAL
  ACTIVE
  PAUSED
}

model Agent {
  id             String      @id @default(uuid())
  businessId     String
  business       User        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  primaryColor   String      @default("#06b6d4")
  // Injected as the model's system instructions on every chat turn —
  // defines the agent's persona/scope. Kept server-side only, never sent
  // to the widget.
  systemPrompt   String
  // Origins the widget is allowed to call POST /api/v1/chat from (exact
  // match against the request's Origin header) — the core of the public
  // endpoint's abuse defense, since anyone can otherwise embed someone
  // else's agent ID on their own page and burn that business's AI usage.
  allowedOrigins String[]    @default([])
  // Shown by the widget when the agent can't help — an escape hatch to a
  // real human, not itself dialed by anything server-side.
  fallbackPhone  String?
  status         AgentStatus @default(TRIAL)
  // 60-day free trial, set at creation (now() + 60 days). See the status
  // enum's comment — nothing here auto-charges when this passes.
  trialEndsAt    DateTime
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  knowledgeDocuments KnowledgeDocument[]
  conversations      AgentConversation[]
  usageRecords       UsageRecord[]

  @@index([businessId])
  @@map("agents")
}

// A single piece of injected context — either a Q&A pair (question set) or
// a freeform context passage (question null). Both just become part of
// the RAG context assembled for each chat request.
model KnowledgeDocument {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  question  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@map("knowledge_documents")
}

// Platform-wide knowledge base for the CDC homepage assistant (Frontend's
// pages/api/chat.ts / lib/gemini.ts) — distinct from the per-business Agent/
// KnowledgeDocument pair above, since this isn't scoped to any Agent, just
// the single global "CDC AI Assistant". Admin-managed via
// routes/adminKnowledge.ts, uploaded as PDF/DOCX/MD and converted to
// Markdown (services/documentParserService.ts) before being split into
// chunks here. Grouped by sourceFilename so the admin UI can list/delete/
// re-sync a whole uploaded document at once instead of per-chunk.
model CdcKnowledgeDocument {
  id             String   @id @default(uuid())
  sourceFilename String
  chunkIndex     Int
  totalChunks    Int
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sourceFilename])
  @@map("cdc_knowledge_documents")
}

// Deliberately separate from the platform's own User-to-User `Message`
// model above — a widget visitor is an anonymous third party, not
// necessarily (or usually) a CDC platform account.
model AgentConversation {
  id         String   @id @default(uuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // Client-generated (widget.js) and persisted in the visitor's browser, so
  // a returning visitor's messages thread into the same conversation
  // instead of starting a new one every page load.
  visitorRef String
  createdAt  DateTime @default(now())

  messages AgentMessage[]

  @@index([agentId])
  @@index([visitorRef])
  @@map("agent_conversations")
}

enum AgentMessageRole {
  USER
  ASSISTANT
}

model AgentMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AgentMessageRole
  content        String
  createdAt      DateTime          @default(now())

  @@index([conversationId])
  @@map("agent_messages")
}

// ============================================================
// PLATFORM AI AGENTS — internal, CDC-owned assistant personas managed from
// the Admin Panel (routes/adminAiAgents.ts, admin/bot-knowledge.tsx's
// "AI Agents" tab). Deliberately a SEPARATE model from `Agent` above: that
// one is a per-BUSINESS embeddable widget a paying Client account owns and
// configures for their own external site (billing/trial, allowedOrigins,
// etc.) — these are CDC's own assistants, not something a customer creates.
//
// Only one PlatformAgent can be `isDefault` at a time — that's the one
// actually driving the CDC homepage assistant (pages/api/chat.ts calls
// getActiveHomepageAgent(), see lib/platformAgents.ts), falling back to the
// existing hardcoded SYSTEM_PROMPT/full-knowledge-base behavior unchanged
// when none is set. The other agents (e.g. Career Advisor, Resume Reviewer)
// are fully configurable — name, system prompt, active flag, assigned
// knowledge sources — but have no dedicated chat surface of their own yet;
// they exist as ready-to-use personas for whenever such a surface is built,
// not as inert placeholders with no real behavior at all (the default-agent
// switch on the homepage IS real, exercised behavior).
// ============================================================
model PlatformAgent {
  id           String   @id @default(uuid())
  name         String
  nameEn       String?
  // Stable identifier for future non-homepage integrations — not currently
  // used to route anything itself (isDefault is what the homepage reads).
  slug         String   @unique
  systemPrompt String
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  knowledgeSources PlatformAgentKnowledgeSource[]

  @@map("platform_agents")
}

// Assigns a whole uploaded CdcKnowledgeDocument (grouped by sourceFilename,
// same grouping adminKnowledge.ts's /sources endpoint already uses — a
// document is many chunk rows, not a single id) to a PlatformAgent. No FK to
// CdcKnowledgeDocument itself since that model has no single-row-per-document
// identity to reference; sourceFilename is the shared key both sides already
// group on.
model PlatformAgentKnowledgeSource {
  id              String        @id @default(uuid())
  platformAgentId String
  platformAgent   PlatformAgent @relation(fields: [platformAgentId], references: [id], onDelete: Cascade)
  sourceFilename  String
  createdAt       DateTime      @default(now())

  @@unique([platformAgentId, sourceFilename])
  @@index([platformAgentId])
  @@map("platform_agent_knowledge_sources")
}

// Structural for now — validated and its discount computed at redemption
// time, but not yet wired into a real checkout flow (see Agent's own
// comment on why billing is deferred). currentUses is incremented
// atomically by the redemption route once that exists.
model PromoCode {
  id              String          @id @default(uuid())
  code            String          @unique
  discountPercent Int?
  discountAmount  Int?
  expiresAt       DateTime?
  maxUses         Int?
  currentUses     Int             @default(0)
  createdAt       DateTime        @default(now())
  bogPayments     BogPayment[]
  stripePayments  StripePayment[]

  @@map("promo_codes")
}

// ============================================================
// MENTORSHIP REQUEST — the Dashboard's "დახმარება / მენტორობა" button
// (CDC Verified Graduates only). Deliberately separate from Gig's
// `mentorHelpRequestedAt` (which is scoped to one specific first-order gig,
// surfaced in adminMentorship's existing gig queue) — this is a general,
// not-tied-to-any-gig ask for order/gig help, so a graduate can reach out
// even when they don't have an active first-order gig to attach it to.
// ============================================================
enum MentorshipRequestStatus {
  OPEN
  RESOLVED
}

model MentorshipRequest {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("MentorshipRequestsMade", fields: [userId], references: [id], onDelete: Cascade)

  message String

  status       MentorshipRequestStatus @default(OPEN)
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?                   @relation("MentorshipRequestsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([status])
  @@map("mentorship_requests")
}

// One-way admin-to-user notifications (Send Notification tool in the admin
// panel, surfaced via the header bell) — deliberately no reply/thread
// concept, unlike MessageThread.
model Notification {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  // Free-form category tag ("MODERATION" | "ADMIN_DIRECT" | "SYSTEM", etc.)
  // — not a Prisma enum since admin-authored notification types may grow
  // without needing a migration each time.
  type      String             @default("ADMIN_DIRECT")
  isRead    Boolean            @default(false)
  // Set alongside isRead the first time it flips true — POST
  // /notifications/:id/read never overwrites it on a later call, so it
  // stays the *first* open time. Null while unread.
  readAt    DateTime?
  // Only set for a notification sent via POST /admin/notifications (the
  // manual broadcast form) — null for every automated notification.create
  // call elsewhere in the codebase (product moderation, KYC, live training
  // leads, etc.), which have no batch to belong to. Cascade: deleting the
  // batch (an admin's own "delete this sent notification" action) removes
  // it from every recipient's bell/hub too, not just the admin's history.
  batchId   String?
  batch     NotificationBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([batchId])
  @@map("notifications")
}

// One row per admin broadcast from POST /admin/notifications — the
// individual Notification rows it fanned out to (one per recipient,
// linked via Notification.batchId) are what each user actually sees; this
// is what /admin/notifications' history table lists, with a read-count
// computed from those linked rows.
model NotificationBatch {
  id             String   @id @default(uuid())
  title          String
  message        String
  type           String   @default("ADMIN_DIRECT")
  // Exactly one of these was the original send target — kept (not just
  // targetLabel) so "Resend" can reconstruct the actual recipient set
  // rather than only having a display string to work from.
  targetUserId   String?
  targetRole     String?
  // Human-readable rendering of whichever target field is set, computed
  // once at send time (e.g. the recipient's email, or "All Users") so the
  // history table never needs a join back to targetUserId just to display
  // a label — that user could since be deleted anyway.
  targetLabel    String
  recipientCount Int
  sentById       String
  sentBy         User     @relation(fields: [sentById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())

  notifications Notification[]

  @@index([sentById])
  @@map("notification_batches")
}

// ============================================================
// SUCCESS STORY — curated graduate testimonials shown on the homepage and
// course detail pages. Deliberately NOT tied to a real User row: these are
// admin-curated marketing content (name/role/course are free text an
// admin types in, not necessarily matching an actual platform account),
// same posture as the homepage's other admin-authored content blocks.
// ============================================================

model SuccessStory {
  id             String   @id @default(uuid())
  studentName    String
  // URL-friendly identifier for /success-stories/[slug], auto-generated
  // from studentName at creation (see routes/adminSuccessStories.ts) — same
  // posture as StudioCaseStudy.slug/BlogPost.slug.
  slug           String   @unique
  // Uploaded via the same Bunny Storage pipeline as everything else
  // (POST /api/success-stories/upload-avatar) — never a freely-settable
  // external URL, consistent with avatarUrl/verificationDocUrl elsewhere.
  avatarUrl      String?
  roleTitle      String
  // English twin — optional, same "public pages fall back to Georgian when
  // unset" posture as StudioCaseStudy's titleEn/descriptionEn/fullStoryEn.
  // studentName and courseName are deliberately NOT twinned: studentName is
  // a proper noun, and courseName mirrors StudioCaseStudy's own `category`
  // field, which is likewise single-language and used for grid filtering.
  roleTitleEn    String?
  courseName     String
  testimonial    String
  testimonialEn  String?
  // Full "success journey" article for the /success-stories/[slug] detail
  // page — optional, since the short testimonial quote above is enough for
  // a card and not every story needs a full write-up.
  storyContent   String?
  storyContentEn String?
  galleryImages  String[] @default([])
  linkedinUrl    String?
  // Distinct from linkedinUrl — a portfolio site / live work sample, same
  // role StudioCaseStudy.projectUrl plays for a case study.
  portfolioUrl   String?
  // Free-text outcome badge, e.g. "დასაქმდა Bank of Georgia-ში" / "Top
  // Rated Freelancer on Upwork" — shown on both the card and the detail
  // page hero. Optional since not every story has a single hire/outcome to
  // name.
  hiredBy        String?
  isFeatured     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isFeatured])
  @@map("success_stories")
}

// ============================================================
// TEAM MEMBER — admin-managed staff/trainer directory shown on the
// homepage "ჩვენი გუნდი" section and the public /trainers page. Deliberately
// NOT tied to a real User row, same posture as SuccessStory above: this is
// admin-curated marketing content, not an account.
// ============================================================

enum TeamMemberType {
  MANAGEMENT
  TRAINER
}

model TeamMember {
  id         String         @id @default(uuid())
  name       String
  role       String
  bio        String?
  // Optional English twins — same "falls back to Georgian when unset"
  // convention as mentorTitleEn/bioEn on User, StudioCaseStudy.titleEn,
  // etc. Never required: adding a team member/trainer only in Georgian is
  // fine, the public /trainers and homepage Team section just render the
  // Georgian text on the English locale too until these are filled in.
  nameEn     String?
  roleEn     String?
  bioEn      String?
  // Uploaded via the same Bunny Storage pipeline as SuccessStory.avatarUrl —
  // never a freely-settable external URL.
  imageUrl   String?
  // Internal site path (e.g. "/about/ia-tavdishvili") to a dedicated
  // full-bio page for this person — set by an admin only for members who
  // actually have one; renders a "View Full Profile" link on this card
  // when present, nothing otherwise.
  profileUrl String?
  type       TeamMemberType @default(MANAGEMENT)
  order      Int            @default(0)
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([type, active])
  @@map("team_members")
}

// ============================================================
// STUDIO CASE STUDY — CDC Studio portfolio entries shown on the public
// /cases showcase and the homepage "Featured Case Studies" block. Distinct
// from StudioInquiry above (inbound leads) — this is outbound portfolio
// content, admin-authored, not submitted by anyone.
// ============================================================

model StudioCaseStudy {
  id            String   @id @default(uuid())
  title         String
  // URL-friendly identifier for /cases/[slug], auto-generated from title at
  // creation (see routes/adminStudioCases.ts) — same posture as BlogPost.slug.
  slug          String   @unique
  clientName    String
  category      String
  description   String
  fullStory     String?
  // English twins — optional, same "public pages fall back to Georgian when
  // unset" posture as BlogPost's titleEn/descriptionEn/contentEn. clientName
  // and category are deliberately NOT twinned: clientName is a proper noun
  // (a company's name doesn't change per locale) and category mirrors
  // BlogPost's own category field, which is likewise single-language.
  titleEn       String?
  descriptionEn String?
  fullStoryEn   String?
  coverImageUrl String?
  galleryImages String[] @default([])
  // Optional YouTube/Vimeo URL or direct .mp4 link — rendered as a
  // responsive embed on /cases/[slug] above the photo gallery when set.
  videoUrl      String?
  projectUrl    String?
  isFeatured    Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isFeatured])
  @@map("studio_case_studies")
}

// ============================================================
// GRANT & TENDER SCOUT — autonomous daily scan of external funding sites
// (grantScoutService.ts, triggered by POST /api/cron/scan-grant-opportunities,
// same secret-gated cron shape as blogAgentService.ts's draft cron). Every
// scraped listing is run through Gemini (via aiAgentService.ts's existing
// callTextModel — no separate AI client) to answer three fixed questions:
// is Georgia eligible, does it fit CDC's scope, and what are the
// deadline/budget. Reviewed on /admin/opportunities.
// ============================================================

// null on either boolean below means the AI couldn't confidently determine
// it from the scraped page (kept distinct from an explicit false) — either
// null collapses eligibilityStatus to NEEDS_REVIEW rather than guessing.
enum GrantEligibilityStatus {
  ELIGIBLE
  NOT_ELIGIBLE
  NEEDS_REVIEW
}

// Admin-configurable scrape targets so adding/pausing a source (grantebi.ge,
// salto-youth.net, a specific EU portal listing page) is a data change on
// /admin/opportunities, not a code deploy — same "admin-configured, not
// hardcoded" posture as PlatformAgent.
model GrantSource {
  id             String    @id @default(uuid())
  name           String
  baseUrl        String
  // One or more listing/index pages to crawl per scan — a single source can
  // have more than one feed worth scanning (e.g. grantebi.ge's separate
  // grants vs. tenders sections).
  listingUrls    String[]  @default([])
  isActive       Boolean   @default(true)
  lastScanAt     DateTime?
  // "success" | "failed" | null (never scanned) — free-form like
  // Notification.type, not a Prisma enum, since scan outcomes may grow more
  // detail later without a migration.
  lastScanStatus String?
  lastScanError  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  opportunities GrantOpportunity[]

  @@map("grant_sources")
}

model GrantOpportunity {
  id           String      @id @default(uuid())
  sourceId     String
  source       GrantSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  // Canonical detail-page URL — the dedupe key alongside sourceId, so a
  // rescan of an already-seen listing updates the existing row instead of
  // duplicating it.
  sourceUrl    String
  title        String
  titleEn      String?
  // AI-generated markdown bullet summary of the opportunity.
  summary      String
  organization String?

  deadline       DateTime?
  // Whole-currency-unit Int — deliberately NOT minor units/cents like
  // BogPayment.amount or Course.originalPrice elsewhere in this schema.
  // This is an informational figure parsed off a funder's page for display
  // only; no payment ever moves through it, so cent precision would imply
  // an accuracy the extraction doesn't actually have.
  budgetMin      Int?
  budgetMax      Int?
  budgetCurrency String? // ISO 4217, e.g. "EUR", "GEL"

  georgiaEligible       Boolean?
  georgiaEligibleReason String
  scopeMatch            Boolean? // fits Digital Education/Youth/Tech/Entrepreneurship?
  scopeMatchReason      String
  // Derived from the two booleans above at write time (see
  // grantScoutService.ts) — never set directly from a partial AI answer.
  eligibilityStatus     GrantEligibilityStatus @default(NEEDS_REVIEW)

  // Admin-dismissed rows are hidden from the default dashboard view but
  // kept (not deleted) for audit — same posture as soft-delete elsewhere
  // in this schema (User.deletionRequestedAt, etc).
  isArchived        Boolean   @default(false)
  archivedReason    String?
  reviewedByAdminId String?
  reviewedByAdmin   User?     @relation(fields: [reviewedByAdminId], references: [id])
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, sourceUrl])
  @@index([eligibilityStatus, isArchived, deadline])
  @@map("grant_opportunities")
}

// ============================================================
// AI SALES & MARKETING MANAGER — on-demand "Generate Sales Launch Kit"
// button on a DigitalProduct or Course row in the admin panel
// (marketingAgentService.ts, POST /api/admin/marketing/launch-kits). Unlike
// the grant scout above this is synchronous and admin-triggered, not a
// cron job — same request/response shape as aiAgentsSuite.ts's /generate.
// ============================================================

enum LaunchKitTargetType {
  DIGITAL_PRODUCT
  COURSE
}

// Regenerating creates a new row rather than overwriting the last one —
// same "never destructively overwrite an AI draft" posture as BlogPost's
// AI-generated drafts. The admin UI shows the latest by createdAt; older
// generations stay as history.
model LaunchKit {
  id         String              @id @default(uuid())
  targetType LaunchKitTargetType
  // Exactly one of productId/courseId is set, matching targetType —
  // enforced in adminMarketing.ts (Prisma has no XOR constraint to express
  // this in the schema itself).
  productId  String?
  product    DigitalProduct?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  courseId   String?
  course     Course?             @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Facebook/Instagram posts — [{ platform, hook, body, cta, hashtags: string[] }]
  socialPosts       Json
  // LinkedIn post + direct sales email, targeting partners/schools/businesses.
  linkedinPost      String
  salesEmailSubject String
  salesEmailBody    String
  // { demographics: string[], positioning: string[], recommendedChannels: string[] }
  audienceProfile   Json

  lang              String   @default("ka") // "ka" | "en"
  generatedByUserId String
  generatedByUser   User     @relation(fields: [generatedByUserId], references: [id])
  createdAt         DateTime @default(now())

  @@index([productId])
  @@index([courseId])
  @@map("launch_kits")
}
