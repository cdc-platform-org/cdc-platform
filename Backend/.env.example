# Copy this file to .env and fill in real values before running the app.
# See src/utils/env.ts for how each of these is read/validated.

# ============================================================
# REQUIRED — the app throws at boot if any of these are missing.
# ============================================================

# PostgreSQL connection string (Prisma).
DATABASE_URL="postgresql://user:password@localhost:5432/cdc_platform?schema=public"

# Secret used to sign/verify JWTs (jsonwebtoken). Use a long, random value in
# production — never reuse the local dev value below.
JWT_SECRET="replace-with-a-long-random-secret"

PORT=4000

# Azure Blob Storage — video/asset uploads (routes/upload.ts). No key or
# connection string: auth is via Managed Identity in Azure, or `az login`
# locally. e.g. "https://<account>.blob.core.windows.net" in production, or
# an Azurite emulator URL locally.
AZURE_STORAGE_ACCOUNT_URL="https://127.0.0.1:10000/devstoreaccount1"
AZURE_STORAGE_CONTAINER_NAME="videos"

# Shared secret an external scheduler (Azure Logic App, GitHub Actions cron,
# cron-job.org, etc.) must send as the X-Cron-Secret header when hitting
# POST /api/cron/auto-approve — see routes/cron.ts. Generate with e.g.
# `openssl rand -hex 24`.
CRON_SECRET="replace-with-a-random-secret"

# ============================================================
# OPTIONAL — the app boots fine without these; the dependent feature is
# disabled (or falls back to an Admin Panel-configured value) until set.
# ============================================================

# Public origin of the deployed frontend — used to build links sent in
# emails (email verification), BOG payment redirect URLs, and as the
# allowed CORS origin in server.ts. Defaults to http://localhost:3000 if
# unset (in production this should be the real frontend domain).
FRONTEND_URL="http://localhost:3000"

# Extra browser origins allowed to call this API, comma-separated (e.g. a
# staging preview URL) — on top of FRONTEND_URL, which is always allowed.
# Unset by default.
# ADDITIONAL_CORS_ORIGINS="https://staging.cdc.org.ge"

# Sentry error tracking (see src/instrument.ts). Leave blank and Sentry
# stays fully disabled (no SDK calls, no network activity) — same
# "optional until set" pattern as every other integration above.
SENTRY_DSN=

# Public origin of THIS backend, reachable by Bank of Georgia's servers —
# used as the BOG webhook callback URL. Defaults to http://localhost:$PORT,
# which will NOT work with real BOG callbacks in production (BOG can't reach
# localhost) — must be a real public HTTPS URL there.
BACKEND_URL="http://localhost:4000"

# Google Cloud OAuth 2.0 Web application Client ID — enables "Sign in with
# Google" (POST /api/auth/google responds 501 until this is set). Must match
# the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID (same Google Cloud OAuth
# client, from Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth App (github.com/settings/developers) — enables "Sign in with
# GitHub" (GET /api/auth/github responds 501 until both are set). The
# "Authorization callback URL" registered in the GitHub app must exactly
# match GITHUB_CALLBACK_URL below (or {BACKEND_URL}/api/auth/github/callback
# if unset) — a mismatch is what GitHub's "redirect_uri is not associated
# with this application" error means.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Optional — only needed if the GitHub app's registered callback URL differs
# from {BACKEND_URL}/api/auth/github/callback. Leave unset to use that default.
GITHUB_CALLBACK_URL=""

# Facebook App (developers.facebook.com) — enables "Sign in with Facebook"
# (GET /api/auth/facebook responds 501 until both are set). The redirect URI
# registered in the Facebook app must exactly match FACEBOOK_CALLBACK_URL
# below (or {BACKEND_URL}/api/auth/facebook/callback if unset).
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# Optional — only needed if the Facebook app's registered redirect URI differs
# from {BACKEND_URL}/api/auth/facebook/callback. Leave unset to use that default.
FACEBOOK_CALLBACK_URL=""

# Bank of Georgia (BOG) Payment API credentials (OAuth2 client_credentials —
# see services/bogPaymentService.ts). Leave blank to fall back to the Admin
# Panel's BOG settings (/admin/financials, SuperAdmin-only, stored in the
# bog_settings table) — real BOG-issued Client ID / Secret Key from your BOG
# merchant onboarding.
BOG_CLIENT_ID=""
BOG_SECRET_KEY=""

# Bunny Stream (video hosting/CDN for course lessons — see
# services/bunnyStreamService.ts). Leave blank to disable lesson video
# upload/playback (those routes respond 501 until set).
# - BUNNY_STREAM_API_KEY: Bunny Stream library API key (Bunny dashboard →
#   Stream → your library → API).
# - BUNNY_STREAM_LIBRARY_ID: numeric Video Library ID.
# - BUNNY_CDN_HOSTNAME: the library's pull-zone hostname, e.g.
#   "vz-xxxxxxxx-xxx.b-cdn.net" — used for thumbnail URLs only; playback uses
#   the fixed player.mediadelivery.net embed domain, which needs no config.
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_CDN_HOSTNAME=""

# Bunny Storage — a plain object-storage zone for images/files (blog
# covers, gallery photos, CMS images). Distinct from Bunny Stream above,
# which is video-specific. Without these, image upload routes respond 501
# (see services/bunnyStorage.ts).
# - BUNNY_STORAGE_ZONE_NAME: your storage zone's name (Bunny dashboard →
#   Storage → your zone).
# - BUNNY_STORAGE_API_KEY: that zone's password/FTP & API access key.
# - BUNNY_STORAGE_HOST: the storage endpoint region host — defaults to
#   "storage.bunnycdn.com" (main/Falkenstein region) if unset.
# - BUNNY_CDN_URL: the zone's public pull-zone base URL, e.g.
#   "https://cdc-storage.b-cdn.net" — no trailing slash.
BUNNY_STORAGE_ZONE_NAME=""
BUNNY_STORAGE_API_KEY=""
BUNNY_STORAGE_HOST=""
BUNNY_CDN_URL=""

# Comma-separated emails that get auto-promoted to adminRole SUPER_ADMIN the
# moment they register, log in, or sign in with Google (see routes/auth.ts's
# maybePromoteSuperAdmin()). Empty by default — opt-in per deployment, not a
# code-level backdoor. Use sparingly; this is a permanent standing grant, not
# a one-off bootstrap like the SEED_SUPERADMIN_* vars below.
SUPER_ADMIN_EMAILS=""

# Google Gemini — powers exam generation, subtitles, blog auto-translate,
# AND the CDC Autonomous Operations Agent's text generation
# (services/aiAgentService.ts). Works on the free tier (Flash models) — no
# billing required. AI cover-image generation is a separate, unauthenticated
# Pollinations.ai call (no env var needed) — see aiAgentService.ts's
# generateCoverImage().
GEMINI_API_KEY=""

# Azure OpenAI — the cross-vendor 4th rung in the AI fallback chain (see
# services/azureOpenAiService.ts), reached only once every model in the
# Gemini fallback sequence above has failed. Leave all three blank and this
# stays fully inert — exam generation/grading behaves exactly as it does
# today, just without a same-vendor-outage safety net. All three must be set
# together; ENDPOINT is your resource's base URL (e.g.
# "https://your-resource.openai.azure.com"), DEPLOYMENT_NAME is the model
# deployment you created in Azure AI Studio (e.g. a gpt-4o deployment), not
# the underlying model name itself.
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT_NAME=""
# Optional — defaults to a known-GA API version (see utils/env.ts) if unset.
# Override only if your deployment requires a different one.
AZURE_OPENAI_API_VERSION=""

# ============================================================
# SEED SCRIPT ONLY (prisma/seed.ts) — not read by the running app. Set these
# as one-off env vars when running `pnpm run db:seed`, not in the committed
# .env. Bootstraps the very first SuperAdmin account (registration is
# hardcoded to Student — see schemas/authSchemas.ts — so without this
# there's no way to ever get an admin account).
# ============================================================

# SEED_SUPERADMIN_EMAIL="admin@example.com"
# SEED_SUPERADMIN_PASSWORD="at-least-8-characters"
# SEED_SUPERADMIN_NAME="System Admin"                # optional, defaults shown
# SEED_ENTERPRISE_EMAIL="enterprise@example.com"      # optional — whole block skipped if unset
# SEED_ENTERPRISE_PASSWORD="at-least-8-characters"    # required only if SEED_ENTERPRISE_EMAIL is set
# SEED_ENTERPRISE_NAME="Enterprise Client"            # optional, defaults shown
