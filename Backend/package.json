    "db:seed": "prisma db seed",
    "db:seed:forum": "ts-node prisma/seedForum.ts",
    "db:seed:e2e": "ts-node prisma/seedE2E.ts",
    "translate:locales": "ts-node scripts/auto-translate-locales.ts",
    "test": "jest",
    "lint": "eslint ."
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.33.0",
    "@fontsource/noto-sans-georgian": "^5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.16.2",
    "@sentry/node": "10.70.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.2.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "openai": "7.5.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.16.2",
    "qrcode": "^1.5.4",
