    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.6",
    "dotenv": "^16.4.3",
    "eslint": "^10.9.0",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0"
