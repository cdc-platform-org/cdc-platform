  "version": "1.0.0",
  "main": "dist/server.js",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
